@model List<CRM.Models.CategoryGroup>

<!-- Dynamic Report look: the shared report chrome first, then this page's own
     styles. category-page.css only uses .cat- / #cat* selectors, so it cannot
     reach into the other master screens. -->
<link rel="stylesheet" href="~/assets/libs/gridjs/theme/mermaid.min.css" />
<link rel="stylesheet" href="~/css/dynamic-report-actions.css?v=2" />
<link rel="stylesheet" href="~/assets/libs/toastify-js/src/toastify.css" />
<link rel="stylesheet" href="~/css/category-page.css?v=2" />

<div class="row">
    <div class="col-12">
        @* The whole panel. The sidebar links replace it through
           /Category/IndexPartial, so nothing outside this partial is re-rendered. *@
        <partial name="Partials/_GroupPanel" model="Model" />
    </div>
</div>

<!-- Add / Edit shell. The body is filled from /Category/ModalForm, which builds
     the fields from sys.columns, so this markup never has to change. -->
<div class="modal fade" id="catModal" tabindex="-1" aria-labelledby="catModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="ri-folder-add-line modal-title-icon"></i>
                    <span id="catModalLabel">Add Category</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="catModalBody">
                <div class="cat-modal-spinner">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading&hellip;</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer" id="catModalFooter" hidden>
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-cat-save" id="catSaveBtn">
                    <i class="ri-save-3-line me-1"></i>Save
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/assets/libs/gridjs/dist/gridjs.production.min.js"></script>
    <script src="~/assets/libs/toastify-js/src/toastify.js"></script>
    <script src="~/js/category-page.js?v=2"></script>
}
