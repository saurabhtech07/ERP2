    <div class="col-xl-3 col-md-6">
        <div class="card stat-card h-100 stat-grey">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <span class="avatar-title rounded-xl icon-44 bg-solid-grey">
                        <i class="ri-tools-line text-white"></i>
                    </span>
                    <div>
                        <h4 class="fw-bold mb-1 stat-label" id="drc3lbl" title="Loading">Loading&hellip;</h4>
                        <div class="stat-value" id="drc3val">&mdash;</div>
