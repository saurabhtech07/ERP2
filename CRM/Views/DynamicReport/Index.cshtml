@section scripts {
<script src="~/assets/libs/gridjs/dist/gridjs.production.min.js"></script>
    <script src="~/assets/libs/toastify-js/src/toastify.js"></script>
    <script src="~/assets/libs/choices.js/public/assets/scripts/choices.min.js"></script>
<script src="~/js/dynamic-report-actions.js?v=@DateTime.UtcNow.Ticks"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            let grid = null;
            let initialTable = '@Html.Raw(ViewBag.SelectedTable ?? "")';
            let allColumns = [];
            let sourceColumns = [];
            let allRows = [];
            let allColumnTypes = [];
            let filterDefinitions = [];
            let cardDefinitions = [];
            let dateCol = null;
            let filterCols = [];
            let choicesInstances = {};
            let currentRows = [];
            let exportCols = [];
            let isEditableReport = false;
            let keyColumn = '';
            let displayColumn = 'Name';
            let activeTableName = '';
            let deleteTargetKey = null;
            let recordModalInstance = null;
            let deleteModalInstance = null;

            if (initialTable) {
                loadReportData(initialTable);
            } else {
                document.getElementById('dynamicGrid').innerHTML = '<div class="alert alert-info">Please select a report from the sidebar.</div>';
            }

// Search logic
            var searchInput = document.getElementById('reportSearch');
            var searchClear = document.getElementById('searchClear');
            function applySearchKeyword(kw) {
                // Cards + record count bhi update hon, isliye ek hi path se filter karo
                if (grid) {
                    applyFilters();
                }
            }
            var searchDebounce = null;
            searchInput.addEventListener('input', function (e) {
                searchClear.style.display = e.target.value ? 'inline-flex' : 'none';
                // har keystroke pe full re-render bhaari ho sakta hai, isliye debounce
                clearTimeout(searchDebounce);
                searchDebounce = setTimeout(function () { applySearchKeyword(e.target.value); }, 250);
            });
            searchClear.addEventListener('click', function () {
                searchInput.value = '';
                searchClear.style.display = 'none';
                searchInput.focus();
                clearTimeout(searchDebounce);
                applySearchKeyword('');
            });

// Date / dropdown filter events
            document.getElementById('drcFromDate').addEventListener('change', function () {
                refreshDependentFilters(-1);
                applyFilters();
            });
            document.getElementById('drcToDate').addEventListener('change', function () {
                refreshDependentFilters(-1);
                applyFilters();
            });

            // Clear button
            document.getElementById('btn-clear').addEventListener('click', function () {
                document.getElementById('reportSearch').value = '';
                document.getElementById('searchClear').style.display = 'none';
                clearTimeout(searchDebounce);
                document.getElementById('drcFromDate').value = '';
                document.getElementById('drcToDate').value = '';
                filterCols.forEach(function (f) {
                    var ch = choicesInstances[f.col];
                    if (ch) { try { ch.setChoiceByValue('__ALL__'); } catch (e) { } }
                });
                refreshDependentFilters(-1);
                applyFilters();
            });

            document.getElementById('drcFilterToggle').addEventListener('click', function () {
                var expanded = this.getAttribute('aria-expanded') === 'true';
                var nextLabel = expanded ? 'Expand filters' : 'Collapse filters';
                this.setAttribute('aria-expanded', String(!expanded));
                this.setAttribute('aria-label', nextLabel);
                this.title = nextLabel;
                this.textContent = expanded ? '+' : '−';
                document.getElementById('drcFilterBody').hidden = expanded;
            });

// Export buttons (ItemMaster-style)
            function getReportTitle() {
                var el = document.getElementById('reportName');
                return el ? el.textContent.trim() : 'Report';
            }

            function escHtml(s) {
                return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
            }


            function csvVal(v) {
                var s = String(v == null ? '' : v);
                if (/^\d{4}-\d{2}-\d{2}T/.test(s) || /^\d{4}-\d{2}-\d{2} /.test(s)) s = s.slice(0, 10);
                return '"' + s.replace(/"/g, '""') + '"';
            }

            function download(filename, content, type) {
                var blob = new Blob([content], { type: type + ';charset=utf-8;' });
                var a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(a.href);
            }

            function getExportRows() {
                // currentRows already carries date + dropdown + search filters (applyFilters)
                return (currentRows ? currentRows : allRows).slice();
            }

            function exportCsv() {
                var rows = getExportRows();
                var header = ['Sr.No'].concat(exportCols.map(function (c) { return c.label; })).join(',');
                var lines = rows.map(function (r, i) {
                    return (i + 1) + ',' + exportCols.map(function (c) { return csvVal(r[c.key]); }).join(',');
                });
                download(getReportTitle().replace(/[^\w-]+/g, '_') + '_' + new Date().toISOString().slice(0, 10) + '.csv', '\uFEFF' + header + '\n' + lines.join('\n'), 'text/csv');
            }

            function exportExcel() {
                var rows = getExportRows();
                var head = ['Sr.No'].concat(exportCols.map(function (c) { return escHtml(c.label); })).map(function (h) { return '<th>' + h + '</th>'; }).join('');
                var body = rows.map(function (r, i) {
                    var cells = exportCols.map(function (c) { return '<td>' + escHtml(r[c.key]) + '</td>'; });
                    return '<tr><td>' + (i + 1) + '</td>' + cells.join('') + '</tr>';
                }).join('');
                download(getReportTitle().replace(/[^\w-]+/g, '_') + '_' + new Date().toISOString().slice(0, 10) + '.xls', '\uFEFF' + '<table border="1"><tr>' + head + '</tr>' + body + '</table>', 'application/vnd.ms-excel');
            }

            function printTable() {
                var rows = getExportRows();
                var w = window.open('', '_blank');
                if (!w) {
                    Toastify({ text: 'Popup blocked. Allow popups to print.', duration: 3000, close: true, gravity: "top", position: "right", backgroundColor: "#f06548" }).showToast();
                    return;
                }
                var head = ['Sr.No'].concat(exportCols.map(function (c) { return escHtml(c.label); })).map(function (h) { return '<th>' + h + '</th>'; }).join('');
                var body = rows.map(function (r, i) {
                    var cells = exportCols.map(function (c) {
                        var v = r[c.key];
                        if (/^\d{4}-\d{2}-\d{2}T/.test(String(v == null ? '' : v)) || /^\d{4}-\d{2}-\d{2} /.test(String(v == null ? '' : v))) v = String(v).slice(0, 10);
                        return '<td>' + escHtml(v) + '</td>';
                    });
                    return '<tr><td>' + (i + 1) + '</td>' + cells.join('') + '</tr>';
                }).join('');
                w.document.write('<!DOCTYPE html><html><head><title>' + escHtml(getReportTitle()) + '</title>');
                w.document.write('<style>body{font-family:Arial,sans-serif;padding:20px}h2{margin-bottom:10px}' +
                    'table{border-collapse:collapse;width:100%;font-size:12px}th,td{border:1px solid #ddd;padding:5px 8px;text-align:left}' +
                    'th{background:#1e3a5f;color:#fff}</style></head><body>');
                w.document.write('<h2>' + escHtml(getReportTitle()) + ' Report</h2>');
                w.document.write('<p>' + rows.length + ' of ' + allRows.length + ' records</p>');
                w.document.write('<table border="1"><tr>' + head + '</tr>' + body + '</table>');
                w.document.write('</body></html>');
                w.document.close();
                w.focus();
                w.print();
            }

            document.getElementById('btn-excel').addEventListener('click', exportExcel);
            document.getElementById('btn-csv').addEventListener('click', exportCsv);
            document.getElementById('btn-print').addEventListener('click', printTable);

            // Rows per page
            document.getElementById('page-size').addEventListener('change', function () {
                this.blur();
                if (!grid) return;
                renderGrid(allColumns, currentRows);
            });

            // Record count
            function updateRecordCount(rows) {
                var el = document.getElementById('record-count');
                if (!el) return;
                el.textContent = (rows ? rows.length : allRows.length) + ' of ' + allRows.length + ' records';
            }

            // Data fail ho jaye to shimmer ko hata kar 'No data' dikhao, warna
            // skeleton hamesha ke liye atak jayega.
            function clearCardSkeletons() {
                var cards = document.getElementById('drcCards').querySelectorAll('.stat-skeleton');
                for (var i = 0; i < cards.length; i++) {
                    cards[i].classList.remove('stat-skeleton');
                    var lbl = cards[i].querySelector('.stat-label');
                    var val = cards[i].querySelector('.stat-value');
                    if (lbl && !lbl.textContent.trim()) lbl.textContent = 'No data';
                    if (val) val.textContent = '\u2014';
                }
            }

            function loadReportData(tableName) {
                document.getElementById('loading').style.display = 'block';
                document.getElementById('dynamicGrid').innerHTML = '';
                activeTableName = tableName;

                fetch(`/DynamicReport/GetReportData?tableName=${encodeURIComponent(tableName)}`)
                    .then(response => response.json())
                    .then(data => {
                        document.getElementById('loading').style.display = 'none';
                        if (data.success) {
                            isEditableReport = !!data.isEditable;
                            keyColumn = data.keyColumn || 'Id';
                            displayColumn = data.displayColumn || 'Name';
                            allColumns = data.columns || [];
                            sourceColumns = Array.isArray(data.sourceColumns) && data.sourceColumns.length === allColumns.length
                                ? data.sourceColumns
                                : allColumns.slice();
                            allRows = data.rows || [];
                            // Stable per-row identity for the ACTIONS column. Reports that
                            // are read-only have no real key, so stamp one on the row itself
                            // - it survives filtering, searching, sorting and paging.
                            allRows.forEach(function (r, i) {
                                if (r) r.__drcRowKey = 'r' + i;
                            });
                            currentRows = allRows;
                            allColumnTypes = data.columnTypes || [];
                            dateCol = data.dateFilterColumn || null;
                            filterDefinitions = Array.isArray(data.filterFields) ? data.filterFields : [];
                            cardDefinitions = Array.isArray(data.cardFields) ? data.cardFields : [];
                            exportCols = allColumns.map(function (c, index) {
                                var label = String(sourceColumns[index] || c);
                                return { key: c, label: label };
                            });
                            var nameEl = document.getElementById('reportName');
                            if (nameEl && data.reportName) {
                                nameEl.textContent = data.reportName;
                                if (document.title) document.title = data.reportName;
                            }
                            initFilters();
                            renderCards(allColumns, allRows);
                            renderGrid(allColumns, allRows);
                            updateRecordCount(allRows);

                            // Lets dynamic-report-actions.js refresh the grid
                            // after a successful save or delete.
                            window.drcReload = function () {
                                loadReportData(activeTableName);
                            };
                        } else {
                            clearCardSkeletons();
                            Toastify({ text: data.message || "Failed to load report.", duration: 3000, close: true, gravity: "top", position: "right", backgroundColor: "#f06548" }).showToast();
                            document.getElementById('dynamicGrid').innerHTML = '<div class="alert alert-danger">Failed to load data.</div>';
                        }
                    })
                    .catch(err => {
                        document.getElementById('loading').style.display = 'none';
                        clearCardSkeletons();
                        Toastify({ text: "Error connecting to server.", duration: 3000, close: true, gravity: "top", position: "right", backgroundColor: "#f06548" }).showToast();
                    });
            }

function renderGrid(columns, rows) {
                var gridWrapper = document.getElementById('dynamicGrid');
                if (!columns || columns.length === 0) {
                    gridWrapper.innerHTML = '<p class="text-muted">No data found.</p>';
                    return;
                }

                var limit = parseInt(document.getElementById('page-size').value, 10) || 10;

                var gridColumns = columns.map(function (c, index) {
                    return {
                        name: String(sourceColumns[index] || c),
                        id: c
                    };
                });

                var gridData = rows.map(row => {
                    let obj = {};
                    columns.forEach(col => {
                        obj[col] = row[col] === null || row[col] === undefined ? '' : row[col];
                    });
                    obj.__drcRowKey = row ? (row.__drcRowKey || '') : '';
                    return obj;
                });

                // Editable masters get Edit + View + Delete; read-only reports still
                // get the column so a row can be opened, just View only.
                gridColumns.push({
                    name: 'ACTIONS',
                    id: '__drcActions',
                    // Grid.js hands the formatter (cell, row, column) where `row` is its
                    // own Row wrapper, not our data object - so the key has to travel
                    // through the supported column `data` hook, which receives the raw row.
                    data: function (row) {
                        return row ? (row.__drcRowKey || '') : '';
                    },
                    width: isEditableReport ? '165px' : '70px',
                    sort: false,
                    // Grid.js escapes a plain string returned from a formatter, so the
                    // buttons have to go through gridjs.html() - same as Item Master.
                    formatter: function (cell) {
                        if (typeof window.drcActionsHtml !== 'function') return '';
                        return window.gridjs.html(window.drcActionsHtml(cell, isEditableReport));
                    }
                });

                // Keep the in-memory row map in sync so View/Edit open instantly,
                // same as Item Master's rowMap.
                if (typeof window.drcSetState === 'function') {
                    window.drcSetState({
                        tableName: activeTableName,
                        keyColumn: keyColumn,
                        isEditable: isEditableReport,
                        columns: allColumns,
                        columnTypes: allColumnTypes,
                        rows: allRows
                    });
                }

                try {
                    if (!grid) {
                        // create once ...
                        grid = new gridjs.Grid({
                            columns: gridColumns,
                            data: gridData,
                            pagination: {
                                enabled: true,
                                limit: limit
                            },
                            sort: true,
                            search: false, // custom #reportSearch box (applyFilters) hi single source of truth
                            className: {
                                table: 'table table-hover table-striped align-middle mb-0'
                            }
                        }).render(gridWrapper);
                    } else {
                        // ... refresh via config (avoids fragile re-instantiation)
                        grid = grid.updateConfig({
                            columns: gridColumns,
                            data: gridData,
                            pagination: {
                                enabled: true,
                                limit: limit
                            },
                            search: false
                        });
                        grid.forceRender();
                    }
                } catch (err) {
                    console.error('[DynRep] renderGrid error:', err);
                    gridWrapper.innerHTML = '<div class="alert alert-warning">Table render error: ' +
                        escHtml(err && err.message ? err.message : String(err)) +
                        '. Data is still available in CSV / Excel / Print.</div>';
                    return;
                }

                // Hide the default GridJS search box since we have our custom one
                setTimeout(() => {
                    var gridJsSearch = gridWrapper.querySelector('.gridjs-search');
                    if (gridJsSearch) {
                        gridJsSearch.style.display = 'none';
                    }
                }, 100);
            }

            // ============ Dynamic Summary Cards ============
            function nfmt(n) {
                return new Intl.NumberFormat('en-IN').format(Math.round(n * 100) / 100);
            }

            function distinctCount(col, rows) {
                var s = new Set();
                for (var i = 0; i < rows.length; i++) {
                    var v = rows[i][col];
                    if (v !== null && v !== undefined && String(v).trim() !== '') s.add(String(v).trim());
                }
                return s.size;
            }

            function sumNumeric(col, rows) {
                var t = 0;
                for (var i = 0; i < rows.length; i++) {
                    var v = rows[i][col];
                    if (v === null || v === undefined) continue;
                    var n = parseFloat(String(v).replace(/[^\d.\-]/g, ''));
                    if (isFinite(n)) t += n;
                }
                return t;
            }

            function isNumericCol(col, rows) {
                for (var i = 0; i < rows.length; i++) {
                    var v = rows[i][col];
                    if (v === null || v === undefined || String(v).trim() === '') continue;
                    return isFinite(parseFloat(String(v).replace(/[^\d.\-]/g, '')));
                }
                // Data nahi aaya (ya poora blank) - tab SP ke column type se decide karo.
                // Type column se aata hai, value se nahi, isliye empty data par bhi sahi rehta hai.
                return isNumericColumnType(getColumnType(col));
            }

            function isNumericColumnType(type) {
                return /int|double|decimal|single|float|long|short|byte|uint|ulong|ushort/.test(String(type || '').toLowerCase());
            }

            // KPI 2/3/4 - database (Kpi2/Kpi3/Kpi4) se. Value format: "Column" ya "Column|Custom Label"
            function resolveKpiCard(def, rows) {
                if (!def || !def.field) return null;

                var found = getColumnEntries(def.field);
                if (!found.length) return null;

                var col = found[0];
                // Note: column match ho gaya to card dikhega, chahe data na aaye.
                // Data khaali hone par value 0 rahega (SUM ya DISTINCT COUNT - type se decide).

                var numeric = isNumericCol(col, rows);
                var money = /amount|amt|mrp|wsp|price|cost|rate/i.test(col);

                return {
                    label: def.label ? def.label : ('Total ' + humanLabel(col)),
                    value: numeric ? sumNumeric(col, rows) : distinctCount(col, rows),
                    col: col,
                    calc: numeric ? 'SUM' : 'DISTINCT COUNT',
                    tone: money ? 'total' : 'qty',
                    icon: numeric
                        ? (money ? 'ri-money-dollar-circle-line' : 'ri-stack-line')
                        : 'ri-file-list-3-line'
                };
            }

            // Mini chart ka fill var(--tone-ink) hai, jo har card tone ka apna
            // strong (icon) colour hai - fixed, to theme customizer par chart
            // ka rang nahi badlega. Shape variant se badalta hai taaki 4 cards
            // ek jaise na lagein.
            function chartSvg(variant) {
                var v = (variant || 0) % 3;
                var bars =
                    v === 0
                        ? '<rect x="0" y="13" width="4" height="11" rx="1.5" opacity="0.4"/><rect x="6" y="9" width="4" height="15" rx="1.5" opacity="0.65"/><rect x="12" y="4" width="4" height="20" rx="1.5"/><rect x="18" y="11" width="4" height="13" rx="1.5" opacity="0.5"/>'
                        : v === 1
                        ? '<rect x="0" y="12" width="4" height="12" rx="1.5" opacity="0.35"/><rect x="6" y="6" width="4" height="18" rx="1.5" opacity="0.65"/><rect x="12" y="2" width="4" height="22" rx="1.5"/><rect x="18" y="9" width="4" height="15" rx="1.5" opacity="0.5"/>'
                        : '<rect x="0" y="10" width="4" height="14" rx="1.5" opacity="0.4"/><rect x="6" y="14" width="4" height="10" rx="1.5" opacity="0.55"/><rect x="12" y="7" width="4" height="17" rx="1.5" opacity="0.85"/><rect x="18" y="3" width="4" height="21" rx="1.5"/>';
                return '<svg viewBox="0 0 24 24" fill="none" style="fill: var(--tone-ink);">' + bars + '</svg>';
            }

            function renderCards(columns, rows) {
                rows = rows || [];
                // columns khali ho tab bhi Card 1 (row count) dikhega; Card 2/3/4 apne aap chhupenge

                // KPI 1 - hamesha row count (fixed)
                var cards = [{
                    label: 'Total Records',
                    value: rows.length,
                    col: '-',
                    calc: 'ROW COUNT',
                    tone: 'total',
                    icon: 'ri-file-list-3-line'
                }];

                // KPI 2, 3, 4 - database se (Kpi2/Kpi3/Kpi4)
                var bySlot = {};
                cardDefinitions.forEach(function (d) { bySlot[d.slot] = d; });
                for (var s = 2; s <= 4; s++) {
                    cards.push(resolveKpiCard(bySlot[s], rows));
                }

                var colorMap = { total: 'orange', qty: 'blue', active: 'green', gst: 'red' };
                var toneOrder = ['blue', 'red', 'orange', 'green'];
                var cardEls = document.getElementById('drcCards').querySelectorAll('.stat-card');
                var visible = 0;
                var usedTones = {};

                for (var i = 0; i < cardEls.length; i++) {
                    var c = cards[i];
                    var cardEl = cardEls[i];
                    if (!cardEl) continue;

                    if (!c) {
                        cardEl.parentElement.classList.add('d-none');
                        continue;
                    }
                    cardEl.parentElement.classList.remove('d-none');
                    visible++;

                    // DB tone normally use hota hai, par agar wahi colour pehle
                    // kisi aur card ne le liya hai to next free slot shift kar
                    // dete hain - isse har card ka icon colour alag rehta hai
                    // (Total Records hamesha tone 'total' deta hai, isliye
                    // bina iske card 1 aur 2 same orange ho jaate the).
                    var color = colorMap[c.tone] || 'orange';
                    if (usedTones[color]) {
                        for (var t = 0; t < toneOrder.length; t++) {
                            if (!usedTones[toneOrder[t]]) { color = toneOrder[t]; break; }
                        }
                    }
                    usedTones[color] = true;

                    cardEl.className = 'card stat-card h-100 stat-' + color;
                    cardEl.querySelector('.avatar-title').className = 'avatar-title rounded-xl icon-44';
                    cardEl.querySelector('.avatar-title i').className = c.icon;
                    cardEl.querySelector('.stat-label').textContent = c.label;
                    cardEl.title = 'Column: ' + c.col + ' | Calculation: ' + c.calc;
                    cardEl.querySelector('.stat-label').title = '';
                    var valueEl = cardEl.querySelector('.stat-value');
                    valueEl.textContent = nfmt(c.value);
                    valueEl.title = '';
                    cardEl.querySelector('.chart-mini').innerHTML = chartSvg(i);
                }

                // Sirf 3 cards ho to teesra poora width le. 1, 2 aur 4 cards
                // default 4-column layout me hi rehte hain - jaisa pehle tha.
                // Count database se aata hai, isliye har report me khud set hota hai.
                var layout = {
                    1: ['col-xl-3', 'col-md-6'],
                    2: ['col-xl-3', 'col-md-6'],
                    3: ['col-xl-4', 'col-md-4'],
                    4: ['col-xl-3', 'col-md-6']
                }[visible] || ['col-xl-3', 'col-md-6'];

                for (var k = 0; k < cardEls.length; k++) {
                    var wrap = cardEls[k].parentElement;
                    wrap.classList.remove('col-xl-12', 'col-xl-6', 'col-xl-4', 'col-xl-3', 'col-md-12', 'col-md-4');
                    if (!wrap.classList.contains('d-none')) {
                        wrap.classList.add(layout[0], layout[1]);
                    }
                }
            }

            // ============ Dynamic Filters ============
            function parseDate(v) {
                if (!v || v === '') return null;
                var d = new Date(v);
                return isNaN(d.getTime()) ? null : d;
            }

            function getFilterFieldName(item) {
                if (typeof item === 'string') return item;
                if (!item) return '';
                return item.field || item.FieldName || item.name || '';
            }

            function isFilterFieldVisible(item) {
                if (typeof item === 'string') return true;
                if (!item) return false;
                if (typeof item.visible === 'string') {
                    return ['false', '0', 'no', 'n', 'off'].indexOf(item.visible.trim().toLowerCase()) < 0;
                }
                return item.visible !== false;
            }

            function colSrcName(i) {
                return String(sourceColumns[i] == null ? allColumns[i] : sourceColumns[i]);
            }

            function normKey(s) {
                return String(s == null ? '' : s).replace(/[^A-Za-z0-9]/g, '').toLowerCase();
            }

            // strict = true -> exact/normalized match, or a unique numbered
            // variant such as Category -> Category1. Ambiguous matches stay hidden.
            // strict = false -> Tier 3 bhi (substring). KPI cards ke liye ye
            // chahiye, kyunki wahan config 'DocDate' likhta hai aur column
            // 'Date' hota hai.
            function getColumnEntries(name, strict) {
                var out = [];
                if (!allColumns || !allColumns.length) return out;
                var requested = String(name == null ? '' : name).trim().toLowerCase();
                if (!requested) return out;
                var want = normKey(name);

                // Tier 1 - exact (original behaviour, always wins)
                for (var i = 0; i < allColumns.length; i++) {
                    if (colSrcName(i).trim().toLowerCase() === requested && out.indexOf(allColumns[i]) < 0) {
                        out.push(allColumns[i]);
                    }
                }
                if (out.length) return out;

                // Tier 2 - normalized (ignores spaces/underscores: "Client Name" <-> "Clientname")
                for (var j = 0; j < allColumns.length; j++) {
                    if (normKey(colSrcName(j)) === want && out.indexOf(allColumns[j]) < 0) {
                        out.push(allColumns[j]);
                    }
                }
                if (out.length) return out;

                if (strict) {
                    var numberedMatches = [];
                    for (var m = 0; m < allColumns.length; m++) {
                        var sourceName = normKey(colSrcName(m));
                        var suffix = sourceName.substring(want.length);
                        if (sourceName.indexOf(want) === 0 && /^\d+$/.test(suffix)) {
                            numberedMatches.push(allColumns[m]);
                        }
                    }
                    return numberedMatches.length === 1 ? numberedMatches : [];
                }

                // Tier 3 - contains ("Date" <-> "DocDate", "Category" <-> "Category1")
                for (var k = 0; k < allColumns.length; k++) {
                    if (normKey(colSrcName(k)).indexOf(want) >= 0 && out.indexOf(allColumns[k]) < 0) {
                        out.push(allColumns[k]);
                    }
                }
                return out;
            }

            function getCompanionIdColumn(nameColumn) {
                var normalizedName = normKey(colSrcName(allColumns.indexOf(nameColumn)));
                if (normalizedName.length <= 4 || !normalizedName.endsWith('name')) return null;

                var expectedId = normalizedName.slice(0, -4) + 'id';
                var matches = [];
                for (var i = 0; i < allColumns.length; i++) {
                    if (normKey(colSrcName(i)) === expectedId) matches.push(allColumns[i]);
                }
                return matches.length === 1 ? matches[0] : null;
            }

            function getColumnType(col) {
                var index = allColumns.indexOf(col);
                return index >= 0 && allColumnTypes[index]
                    ? String(allColumnTypes[index]).toLowerCase()
                    : '';
            }

            // Sirf SP ke bataye hue column types. Value-sniffing (60% parseable
            // hone par date maan lena) aur config/naam par 'date' alias - dono
            // hata diye gaye, warna text columns bhi date filter khol dete the.
            function isDateColumn(col) {
                return getColumnType(col).indexOf('date') >= 0;
            }

            function buildFilterOptions(col, sourceRows) {
                var seen = {};
                var vals = [];
                var rows = sourceRows || allRows;
                for (var i = 0; i < rows.length; i++) {
                    var v = rows[i][col];
                    if (v === null || v === undefined) continue;
                    var s = String(v).trim();
                    if (!s || seen[s]) continue;
                    seen[s] = 1;
                    vals.push(s);
                }
                vals.sort(function (a, b) { return a.localeCompare(b); });
                return vals;
            }

            function getFilterValue(filter) {
                var choice = choicesInstances[filter.col];
                if (choice && typeof choice.getValue === 'function') {
                    var value = choice.getValue(true);
                    return Array.isArray(value) ? String(value[0] || '') : String(value || '');
                }
                return filter.select.value;
            }

            function getRowsForFilterOptions(filterIndex) {
                var rows = allRows.slice();
                var fromValue = document.getElementById('drcFromDate').value;
                var toValue = document.getElementById('drcToDate').value;
                var from = fromValue ? parseDate(fromValue + 'T00:00:00') : null;
                var to = toValue ? parseDate(toValue + 'T23:59:59.999') : null;

                if ((from || to) && dateCol) {
                    rows = rows.filter(function (row) {
                        var value = parseDate(row[dateCol]);
                        return value && (!from || value >= from) && (!to || value <= to);
                    });
                }

                for (var i = 0; i < filterIndex; i++) {
                    var filter = filterCols[i];
                    var selected = getFilterValue(filter);
                    if (!selected || selected === '__ALL__') continue;
                    rows = rows.filter(function (row) {
                        return String(row[filter.col] == null ? '' : row[filter.col]).trim() === selected;
                    });
                }

                return rows;
            }

            function refreshDependentFilters(changedIndex) {
                for (var i = changedIndex + 1; i < filterCols.length; i++) {
                    var filter = filterCols[i];
                    var values = buildFilterOptions(filter.col, getRowsForFilterOptions(i));
                    var selected = getFilterValue(filter);
                    if (values.indexOf(selected) < 0) selected = '__ALL__';

                    var options = [{
                        value: '__ALL__',
                        label: 'All ' + filter.label,
                        selected: selected === '__ALL__'
                    }];
                    values.forEach(function (value) {
                        options.push({ value: value, label: value, selected: value === selected });
                    });

                    var choice = choicesInstances[filter.col];
                    if (choice) {
                        choice.clearStore();
                        choice.setChoices(options, 'value', 'label', true);
                    } else {
                        while (filter.select.options.length) filter.select.remove(0);
                        options.forEach(function (option) {
                            var element = document.createElement('option');
                            element.value = option.value;
                            element.textContent = option.label;
                            element.selected = option.selected;
                            filter.select.appendChild(element);
                        });
                    }
                }
            }

            function detectFilterCols() {
                var out = [];
                if (!allColumns || !allColumns.length || !filterDefinitions.length) return out;
                var usedCols = {};
                for (var i = 0; i < filterDefinitions.length; i++) {
                    if (!isFilterFieldVisible(filterDefinitions[i])) continue;
                    var field = getFilterFieldName(filterDefinitions[i]);
                    // strict: config me 'Alice' likha hai par SP me wo column
                    // nahi hai to filter bilkul nahi dikhega.
                    var found = getColumnEntries(field, true);
                    if (!found.length) continue;
                    var col = found[0];
                    var columnKey = String(col).trim().toLowerCase();
                    if (usedCols[columnKey] || isDateColumn(col)) continue;
                    // Label SP ke asli column se - config ka stale text nahi.
                    out.push({ col: col, label: colSrcName(allColumns.indexOf(col)) || col, options: buildFilterOptions(col) });
                    usedCols[columnKey] = 1;

                    var relatedId = getCompanionIdColumn(col);
                    if (relatedId) {
                        var idKey = String(relatedId).trim().toLowerCase();
                        if (!usedCols[idKey]) {
                            out.push({
                                col: relatedId,
                                label: colSrcName(allColumns.indexOf(relatedId)),
                                options: buildFilterOptions(relatedId)
                            });
                            usedCols[idKey] = 1;
                        }
                    }
                }
                return out;
            }


            function humanLabel(col) {
                var s = col.split(/[^A-Za-z0-9]+/).join(' ');
                return s.charAt(0).toUpperCase() + s.slice(1);
            }
function initFilters() {
    var dateRange = document.getElementById('drcDateRange');
    var fromLbl = document.getElementById('drcFromLbl');
    var toLbl = document.getElementById('drcToLbl');

    // Sirf exact "Date" ho tabhi filter dikhao
    if (dateCol) {
        var boundName = colSrcName(allColumns.indexOf(dateCol)) || dateCol;
        var boundNorm = normKey(boundName);
        // agar Date nahi hai to null kar do
        if (boundNorm !== 'date') {
            dateCol = null;
        }
    }

    if (dateCol) {
        var bound = colSrcName(allColumns.indexOf(dateCol)) || dateCol;
        fromLbl.textContent = 'From ' + bound;
        toLbl.textContent = 'To ' + bound;
        dateRange.hidden = false;
        document.getElementById('drcFromDate').value = '';
        document.getElementById('drcToDate').value = '';
    } else {
        dateRange.hidden = true;
    }

    // ... baaki ka filterCols wala code same rehne do

                filterCols = [];
                choicesInstances = {};
                var mounts = document.getElementById('drcFilterMounts');
                var row = document.getElementById('drcFilterRow');
                row.innerHTML = '';
                if (allColumns && allColumns.length) {
                    var cols = detectFilterCols();
                    cols.forEach(function (res) {
                        var div = document.createElement('div');
                        div.className = 'drc-filter-item';
                        var lbl = document.createElement('label');
                        lbl.className = 'form-label fs-label-sm';
                        lbl.textContent = humanLabel(res.label || res.col);
                        var sel = document.createElement('select');
                        sel.className = 'form-select drc-filter-select';
                        sel.dataset.col = res.col;
                        var allOpt = document.createElement('option');
                        allOpt.value = '__ALL__';
                        allOpt.textContent = 'All ' + humanLabel(res.label || res.col);
                        sel.appendChild(allOpt);
                        res.options.forEach(function (o) {
                            var opt = document.createElement('option');
                            opt.value = o;
                            opt.textContent = o;
                            sel.appendChild(opt);
                        });
                        sel.selectedIndex = 0;
                        div.appendChild(lbl);
                        div.appendChild(sel);
                        row.appendChild(div);
                        var filterIndex = filterCols.length;
                        filterCols.push({ col: res.col, label: humanLabel(res.label || res.col), select: sel });
                        sel.addEventListener('change', function () {
                            refreshDependentFilters(filterIndex);
                            applyFilters();
                        });
                        try {
                            choicesInstances[res.col] = new Choices(sel, {
                                searchEnabled: true,
                                searchFloor: 1,
                                shouldSort: false,
                                position: 'bottom',
                                itemSelectText: '',
                                placeholder: false
                            });
                        } catch (e) { }
                    });
                    mounts.hidden = filterCols.length === 0;
                } else {
                    mounts.hidden = true;
                }

                var hasFilters = filterCols.length > 0 || !!dateCol;
                document.getElementById('drcFiltersSection').hidden = !hasFilters;
                document.getElementById('drcFilterTitle').textContent = 'Filters for ' + getReportTitle();
                var filterToggle = document.getElementById('drcFilterToggle');
                filterToggle.setAttribute('aria-expanded', 'true');
                filterToggle.setAttribute('aria-label', 'Collapse filters');
                filterToggle.title = 'Collapse filters';
                filterToggle.textContent = '−';
                document.getElementById('drcFilterBody').hidden = false;
            }

            function applyFilters() {
                if (!allColumns.length || !allRows.length) return;
                var rows = allRows.slice();

                var fromVal = document.getElementById('drcFromDate').value;
                var toVal = document.getElementById('drcToDate').value;
                var from = fromVal ? parseDate(fromVal + 'T00:00:00') : null;
                var to = toVal ? parseDate(toVal + 'T23:59:59.999') : null;

                if ((from || to) && dateCol) {
                    rows = rows.filter(function (r) {
                        var d = parseDate(r[dateCol]);
                        if (!d) return false;
                        if (from && d < from) return false;
                        if (to && d > to) return false;
                        return true;
                    });
}

// dropdown filters (multi)
                filterCols.forEach(function (f) {
                    var fv;
                    var ch = choicesInstances[f.col];
                    if (ch && typeof ch.getValue === 'function') {
                        var got = ch.getValue(true);
                        fv = Array.isArray(got) ? (got.length ? String(got[0]) : '') : String(got || '');
                    } else {
                        fv = f.select.value;
                    }
                    if (!fv || fv === '__ALL__') return;
                    rows = rows.filter(function (r) {
                        var v = r[f.col];
                        return String(v === null || v === undefined ? '' : v).trim() === fv;
                    });
                });

// search keyword (same matching jo getExportRows() use karta hai)
                var kw = document.getElementById('reportSearch').value.trim().toLowerCase();
                if (kw) {
                    rows = rows.filter(function (r) {
                        for (var ci = 0; ci < allColumns.length; ci++) {
                            var cv = r[allColumns[ci]];
                            if (String(cv === null || cv === undefined ? '' : cv).toLowerCase().indexOf(kw) >= 0) return true;
                        }
                        return false;
                    });
                }

currentRows = rows;
                renderCards(allColumns, rows);
                renderGrid(allColumns, rows);
                updateRecordCount(rows);
            }
        });
    </script>
}

