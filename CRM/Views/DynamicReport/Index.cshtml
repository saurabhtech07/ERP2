                    <span class="avatar-title rounded-xl icon-44 bg-solid-green">
                        <i class="ri-tools-line text-white"></i>
                    </span>
                    <div>
                        <h4 class="fw-bold mb-1 stat-label" id="drc4lbl" title="Loading">Loading&hellip;</h4>
                        <div class="stat-value" id="drc4val">&mdash;</div>
