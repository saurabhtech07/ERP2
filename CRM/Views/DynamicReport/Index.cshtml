@model IEnumerable<CRM.Models.ReportMenuItem>
@{
    ViewData["Title"] = ViewBag.ReportName;
}

@section styles {
<link href="~/assets/libs/gridjs/theme/mermaid.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/libs/toastify-js/src/toastify.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/libs/choices.js/public/assets/styles/choices.min.css" rel="stylesheet" type="text/css" />
    <link href="~/css/item-master.css" rel="stylesheet" type="text/css" />
    <style>
        .fs-label-sm {
            display: block;
            font-size: 10.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.45px;
            color: #64748b;
            margin-bottom: 0.35rem;
        }
.filter-panel input[type="date"],
        .filter-panel .form-select {
            min-height: 38px;
        }

        #dynamicGrid {
            max-height: calc(100vh - 265px);
            min-height: 470px;
            overflow: auto !important;
            border: 1px solid #e9ecef;
            border-radius: 0.6rem;
            background: #ffffff;
            scrollbar-gutter: stable;
        }

        #dynamicGrid .gridjs-wrapper {
            max-height: none !important;
            min-height: 0 !important;
            overflow: visible !important;
            border: 0 !important;
            border-radius: 0 !important;
            box-shadow: none !important;
        }

        #dynamicGrid .gridjs-container,
        #dynamicGrid .gridjs-content {
            display: block !important;
            width: 100% !important;
            overflow: visible !important;
        }

        #dynamicGrid .gridjs-table,
        #dynamicGrid .gridjs-table table {
            width: max-content;
            min-width: 100%;
            border-collapse: separate !important;
            border-spacing: 0;
        }

        #dynamicGrid .gridjs-thead {
            display: table-header-group;
            position: sticky;
            top: 0;
            z-index: 10;
            background: #1e3a5f;
        }

        #dynamicGrid .gridjs-thead th {
            position: sticky !important;
            top: 0;
            z-index: 11;
        }

        #dynamicGrid .gridjs-thead th {
            background-color: #1e3a5f !important;
            color: #fff !important;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 11px 12px;
            border: none !important;
            white-space: nowrap;
            overflow: visible;
        }

        #dynamicGrid .gridjs-thead th .gridjs-th-content {
            overflow: visible;
            text-overflow: clip;
        }

        #dynamicGrid .gridjs-thead th:hover {
            background-color: #274b76 !important;
        }

        #dynamicGrid .gridjs-table {
            margin: 0;
        }

        #dynamicGrid .gridjs-table tbody td {
            vertical-align: middle;
            padding: 10px 12px;
        }

        #dynamicGrid .gridjs-table tbody tr {
            transition: background-color 0.15s ease;
        }

        #dynamicGrid .gridjs-table tbody tr:hover td {
            background-color: #eef4fb;
        }

        #dynamicGrid .gridjs-pagination {
            justify-content: flex-end;
            padding-top: 0.75rem;
        }

        #dynamicGrid button.gridjs-pages button {
            border-radius: 0.375rem;
            margin: 0 0.125rem;
        }

        #dynamicGrid .gridjs-footer {
            background: var(--vz-card-bg);
        }

#dynamicGrid .gridjs-th-sort:hover,
        #dynamicGrid .gridjs-th-sort:focus {
            background: none;
        }
    </style>
    <style>
        /* ================================================================
           POLISH - Pure CSS, logic/DOM untouched.
           Reverse ke liye bas ye poora block delete kar dena.
           ================================================================ */

        /* ---------- Filter panel ---------- */
        .filter-panel {
            position: relative;
            border: 1px solid #e8edf4;
            border-radius: 14px;
            box-shadow: 0 6px 22px -12px rgba(15, 23, 42, 0.16);
        }
        .filter-panel::before {
            content: "";
            position: absolute;
            left: 0;
            top: 12px;
            bottom: 12px;
            width: 4px;
            border-radius: 999px;
            background: linear-gradient(180deg, #405189, #06b6d4, #10b981);
        }
        .filter-panel .fs-label {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            color: #405189;
            margin-bottom: 0.6rem;
        }
        .filter-panel .fs-label i { color: #06b6d4; font-size: 14px; }
        .filter-panel .form-label,
        .filter-panel .fs-label-sm { font-weight: 600; color: #475569; }

        .filter-panel input[type="date"],
        .filter-panel .form-select,
        .filter-panel .choices__inner {
            border-radius: 9px;
            transition: border-color .18s ease, box-shadow .18s ease;
        }
        .filter-panel input[type="date"]:focus,
        .filter-panel .form-select:focus,
        .filter-panel .choices.is-focused .choices__inner,
        .filter-panel .choices.is-open .choices__inner {
            border-color: #405189 !important;
            box-shadow: 0 0 0 3px rgba(64, 81, 137, 0.14);
        }
        .filter-panel .choices__inner {
            background: #ffffff;
            min-height: 38px;
        }
        .filter-panel .choices__list--dropdown {
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            box-shadow: 0 16px 34px -14px rgba(15, 23, 42, 0.22);
            margin-top: 5px;
        }
        .filter-panel .choices__list--dropdown .choices__item--selectable.is-highlighted {
            background: #eef4fb;
        }

        /* ---------- Search (pill) ---------- */
        #drcFromWrap, #drcToWrap { min-width: 150px; }
        #drcFromWrap input[type="date"], #drcToWrap input[type="date"] { width: 155px; }
        #reportSearch {
            border-radius: 999px;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05);
        }
        #reportSearch:focus {
            border-color: #405189;
            box-shadow: 0 0 0 3px rgba(64, 81, 137, 0.14);
        }
        #reportSearch:focus ~ .search-icon { color: #405189; }
        .search-icon { color: #94a3b8; }

        /* ---------- Action buttons ---------- */
        #btn-excel, #btn-csv, #btn-print, #btn-clear { border-radius: 9px; }
        #btn-excel { box-shadow: 0 8px 16px -10px rgba(18, 183, 106, 0.65); }
        #btn-csv   { box-shadow: 0 8px 16px -10px rgba(59, 130, 246, 0.65); }
        #btn-print { box-shadow: 0 8px 16px -10px rgba(139, 92, 246, 0.65); }
        #btn-clear:hover { background: #f1f5f9; border-color: #dbe3ed; }

/* ---------- Cards (corporate KPI style - full revamp) ---------- */
        #drcCards { margin-top: 0.5rem; }
        #drcCards .stat-card {
            position: relative;
            overflow: hidden;
            border: 1px solid #e6eaf0;
            border-radius: 14px;
            background: #ffffff;
            box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04), 0 8px 24px -14px rgba(16, 24, 40, 0.10);
            transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
        }
        #drcCards .stat-card:hover {
            transform: translateY(-3px);
            border-color: #d8dfe9;
            box-shadow: 0 2px 4px rgba(16, 24, 40, 0.05), 0 18px 34px -16px rgba(16, 24, 40, 0.18);
        }

        /* old gradient bar + radial glow hataya */
        #drcCards .stat-card::after {
            display: none !important;
            background: transparent !important;
        }
        /* thin tone accent on the left */
        #drcCards .stat-card::before {
            content: "" !important;
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            border-radius: 0;
            opacity: 1;
            background: transparent !important;
        }
        #drcCards .stat-orange::before { background: #f59e0b !important; }
        #drcCards .stat-blue::before   { background: #3b82f6 !important; }
        #drcCards .stat-grey::before   { background: #64748b !important; }
        #drcCards .stat-green::before  { background: #10b981 !important; }

        #drcCards .stat-card .card-body {
            padding: 0.85rem 1rem;
            gap: 8px;
        }
        #drcCards .stat-card .avatar-title {
            width: 46px;
            height: 46px;
            min-width: 46px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: none !important;
            outline: none !important;
        }
        #drcCards .stat-card .avatar-title i { font-size: 22px; }
        #drcCards .stat-orange .avatar-title { background: #fff5e6 !important; }
        #drcCards .stat-orange .avatar-title i { color: #f59e0b !important; }
        #drcCards .stat-blue .avatar-title { background: #eef4ff !important; }
        #drcCards .stat-blue .avatar-title i { color: #3b82f6 !important; }
        #drcCards .stat-grey .avatar-title { background: #f1f5f9 !important; }
        #drcCards .stat-grey .avatar-title i { color: #64748b !important; }
        #drcCards .stat-green .avatar-title { background: #ecfdf5 !important; }
        #drcCards .stat-green .avatar-title i { color: #10b981 !important; }

        #drcCards .stat-card .stat-label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            color: #64748b;
            line-height: 1.25;
            margin-bottom: 2px;
        }
        #drcCards .stat-card .stat-value {
            font-size: 20px;
            font-weight: 800;
            letter-spacing: -0.5px;
            color: #0f172a;
            line-height: 1.1;
        }
        #drcCards .stat-card .chart-mini { flex-shrink: 0; opacity: 0.85; }
        #drcCards .stat-card .chart-mini svg { width: 38px; height: 34px; }

        /* soft entrance */
        #drcCards .stat-card { animation: drcCardIn .45s ease both; }
        #drcCards .stat-card:nth-child(2) { animation-delay: .06s; }
        #drcCards .stat-card:nth-child(3) { animation-delay: .12s; }
        #drcCards .stat-card:nth-child(4) { animation-delay: .18s; }
        @@keyframes drcCardIn {
            from { opacity: 0; transform: translateY(8px); }
            to   { opacity: 1; transform: none; }
        }

        /* ---------- Premium loading shimmer ---------- */
        #loading .skeleton-card {
            border: 1px solid #e9ecef;
            border-radius: 0.6rem;
            padding: 0.85rem 1rem;
            background: #ffffff;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
            overflow: hidden;
        }
        #loading .skeleton {
            position: relative;
            background: #eef1f5;
            border-radius: 6px;
            height: 14px;
            margin-bottom: 10px;
            overflow: hidden;
        }
        #loading .skeleton-head { height: 18px; width: 42%; margin-bottom: 16px; }
        #loading .skeleton-sk-1 { width: 100%; }
        #loading .skeleton-sk-2 { width: 78%; }
        #loading .skeleton-sk-3 { width: 92%; }
        #loading .skeleton-sk-4 { width: 64%; }
        #loading .skeleton-sk-5 { width: 85%; }
        #loading .skeleton::after {
            content: "";
            position: absolute;
            inset: 0;
            transform: translateX(-100%);
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.7), transparent);
            animation: skeletonShimmer 1.4s ease infinite;
        }
        @@keyframes skeletonShimmer { to { transform: translateX(100%); } }

        /* ---------- Search clear (x) ---------- */
        #reportSearch { padding-right: 2.4rem; }
        .search-clear {
            right: 0.45rem;
            width: 22px;
            height: 22px;
            border: none;
            border-radius: 50%;
            background: transparent;
            color: #94a3b8;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            padding: 0;
            line-height: 1;
            transition: color .15s ease, background .15s ease;
        }
        .search-clear i { font-size: 14px; }
        .search-clear:hover { color: #f06548; background: #f1f5f9; }

        /* ---------- Pagination ---------- */
        #dynamicGrid .gridjs-pagination .gridjs-summary { color: #64748b; font-weight: 500; font-size: 12.5px; }
        #dynamicGrid .gridjs-pagination .gridjs-pages button {
            border-radius: 8px;
            min-width: 30px;
            height: 30px;
            padding: 0 8px;
            box-sizing: border-box;
            border: 1px solid #e2e8f0;
            background: #ffffff;
            color: #475569;
            font-size: 12.5px;
            line-height: 1;
            transition: all .15s ease;
        }
        #dynamicGrid .gridjs-pagination .gridjs-pages button:hover:not(:disabled) {
            background: #eef4fb;
            border-color: #c3cbdc;
            color: #405189;
        }
        #dynamicGrid .gridjs-pagination .gridjs-pages button.gridjs-currentPage {
            background: #405189 !important;
            border-color: #405189 !important;
            color: #ffffff !important;
            font-weight: 600;
            box-shadow: 0 4px 10px -4px rgba(64, 81, 137, 0.5);
        }
        #dynamicGrid .gridjs-pagination .gridjs-pages button:disabled { opacity: 0.55; }

        /* ---------- Grid header + record pill ---------- */
        #reportTableSection .card-header {
            background: #f9fafc;
            border-bottom: 1px solid #eceff4;
        }
        .drc-report-title { display: flex; align-items: center; gap: 10px; min-width: 0; }
        .report-icon-chip {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            flex-shrink: 0;
            border-radius: 10px;
            background: #eef1f9;
            color: #405189;
            font-size: 16px;
        }
        #reportName {
            font-weight: 800;
            color: #0f172a;
            font-size: 15px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .record-count-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: #eef2f7;
            color: #64748b;
            font-size: 11.5px;
            font-weight: 700;
            letter-spacing: 0.3px;
            padding: 3px 10px;
            border-radius: 999px;
            border: 1px solid #e2e8f0;
            white-space: nowrap;
        }
    </style>
}

<!-- Dynamic summary cards (auto-detected per report) -->
<div class="row g-3 mb-3" id="drcCards">
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card h-100 stat-orange">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <span class="avatar-title rounded-xl icon-44 bg-solid-orange">
                        <i class="ri-tools-line text-white"></i>
                    </span>
                    <div>
                        <h4 class="fw-bold mb-1 stat-label" id="drc1lbl" title="Loading">Loading&hellip;</h4>
                        <div class="stat-value" id="drc1val">&mdash;</div>
                    </div>
                </div>
                <div class="chart-mini"><div id="drc1chart"></div></div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card h-100 stat-blue">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <span class="avatar-title rounded-xl icon-44 bg-solid-blue">
                        <i class="ri-tools-line text-white"></i>
                    </span>
                    <div>
                        <h4 class="fw-bold mb-1 stat-label" id="drc2lbl" title="Loading">Loading&hellip;</h4>
                        <div class="stat-value" id="drc2val">&mdash;</div>
                    </div>
                </div>
                <div class="chart-mini"><div id="drc2chart"></div></div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card h-100 stat-grey">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <span class="avatar-title rounded-xl icon-44 bg-solid-grey">
                        <i class="ri-tools-line text-white"></i>
                    </span>
                    <div>
                        <h4 class="fw-bold mb-1 stat-label" id="drc3lbl" title="Loading">Loading&hellip;</h4>
                        <div class="stat-value" id="drc3val">&mdash;</div>
                    </div>
                </div>
                <div class="chart-mini"><div id="drc3chart"></div></div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card h-100 stat-green">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <span class="avatar-title rounded-xl icon-44 bg-solid-green">
                        <i class="ri-tools-line text-white"></i>
                    </span>
                    <div>
                        <h4 class="fw-bold mb-1 stat-label" id="drc4lbl" title="Loading">Loading&hellip;</h4>
                        <div class="stat-value" id="drc4val">&mdash;</div>
                    </div>
                </div>
                <div class="chart-mini"><div id="drc4chart"></div></div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        <div class="card filter-panel">
            <div class="card-body">
                <label class="form-label fs-label"><i class="ri-filter-3-line me-1"></i>Filters</label>
<div class="row g-2 align-items-end">
                    <div class="col-12" id="drcFilterMounts" style="display:none;">
                        <div class="row g-2" id="drcFilterRow"></div>
                    </div>
                </div>

<div class="d-flex flex-wrap gap-2 align-items-end mt-2 pt-2 border-top">
                    <div class="d-flex flex-column" id="drcFromWrap" style="display:none;">
                        <label class="form-label fs-label-sm mb-1">From Date</label>
                        <input type="date" class="form-control" id="drcFromDate">
                    </div>
                    <div class="d-flex flex-column" id="drcToWrap" style="display:none;">
                        <label class="form-label fs-label-sm mb-1">To Date</label>
                        <input type="date" class="form-control" id="drcToDate">
                    </div>
<div class="position-relative flex-grow-1" style="min-width:220px">
                        <input type="text" id="reportSearch" class="form-control ps-5" placeholder="Search in report...">
                        <i class="ri-search-line position-absolute top-50 translate-middle-y ms-3 search-icon"></i>
                        <button type="button" id="searchClear" class="search-clear position-absolute top-50 translate-middle-y" style="display:none;" tabindex="-1" aria-label="Clear search" title="Clear search">
                            <i class="ri-close-line"></i>
                        </button>
                    </div>
                    <button type="button" class="btn btn-light btn-action" id="btn-clear">
                        <i class="ri-refresh-line me-1"></i>Clear
                    </button>
                    <button type="button" class="btn btn-action btn-excel" id="btn-excel">
                        <i class="ri-file-excel-line me-1"></i>Excel
                    </button>
                    <button type="button" class="btn btn-action btn-csv" id="btn-csv">
                        <i class="ri-file-list-line me-1"></i>CSV
                    </button>
                    <button type="button" class="btn btn-action btn-print" id="btn-print">
                        <i class="ri-printer-line me-1"></i>Print
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row table-section" id="reportTableSection">
    <div class="col-xl-12">
        <div class="card table-panel">
            <div class="card-header align-items-center d-flex py-2">
                <h4 class="card-title mb-0 flex-grow-1 fs-15 drc-report-title">
                    <span class="report-icon-chip"><i class="ri-database-2-line"></i></span>
                    <span id="reportName">@ViewBag.ReportName</span>
                    <span class="record-count-pill" id="record-count"></span>
                </h4>
                <div class="d-flex align-items-center gap-2">
                    <small class="text-muted fs-12 fw-medium">Rows per page</small>
                    <select id="page-size" class="form-select form-select-sm">
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
            </div>
            <div class="card-body">
<div id="loading" style="display: none;">
                    <div class="skeleton-card">
                        <div class="skeleton skeleton-head"></div>
                        <div class="skeleton skeleton-sk-1"></div>
                        <div class="skeleton skeleton-sk-2"></div>
                        <div class="skeleton skeleton-sk-3"></div>
                        <div class="skeleton skeleton-sk-4"></div>
                        <div class="skeleton skeleton-sk-5"></div>
                    </div>
                </div>
                <div id="dynamicGrid"></div>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script src="~/assets/libs/gridjs/dist/gridjs.production.min.js"></script>
    <script src="~/assets/libs/toastify-js/src/toastify.js"></script>
    <script src="~/assets/libs/choices.js/public/assets/scripts/choices.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            let grid = null;
            let initialTable = '@Html.Raw(ViewBag.SelectedTable ?? "")';
            let allColumns = [];
            let sourceColumns = [];
            let allRows = [];
            let allColumnTypes = [];
            let filterDefinitions = [];
            let cardDefinitions = [];
            let dateCol = null;
            let filterCols = [];
            let choicesInstances = {};
            let currentRows = [];
            let exportCols = [];

            if (initialTable) {
                loadReportData(initialTable);
            } else {
                document.getElementById('dynamicGrid').innerHTML = '<div class="alert alert-info">Please select a report from the sidebar.</div>';
            }

// Search logic
            var searchInput = document.getElementById('reportSearch');
            var searchClear = document.getElementById('searchClear');
            function applySearchKeyword(kw) {
                // Cards + record count bhi update hon, isliye ek hi path se filter karo
                if (grid) {
                    applyFilters();
                }
            }
            var searchDebounce = null;
            searchInput.addEventListener('input', function (e) {
                searchClear.style.display = e.target.value ? 'inline-flex' : 'none';
                // har keystroke pe full re-render bhaari ho sakta hai, isliye debounce
                clearTimeout(searchDebounce);
                searchDebounce = setTimeout(function () { applySearchKeyword(e.target.value); }, 250);
            });
            searchClear.addEventListener('click', function () {
                searchInput.value = '';
                searchClear.style.display = 'none';
                searchInput.focus();
                clearTimeout(searchDebounce);
                applySearchKeyword('');
            });

// Date / dropdown filter events
            document.getElementById('drcFromDate').addEventListener('change', applyFilters);
            document.getElementById('drcToDate').addEventListener('change', applyFilters);

            // Clear button
            document.getElementById('btn-clear').addEventListener('click', function () {
                document.getElementById('reportSearch').value = '';
                document.getElementById('searchClear').style.display = 'none';
                clearTimeout(searchDebounce);
                document.getElementById('drcFromDate').value = '';
                document.getElementById('drcToDate').value = '';
                filterCols.forEach(function (f) {
                    var ch = choicesInstances[f.col];
                    if (ch) { try { ch.setChoiceByValue('__ALL__'); } catch (e) { } }
                });
                applyFilters();
            });

// Export buttons (ItemMaster-style)
            function getReportTitle() {
                var el = document.getElementById('reportName');
                return el ? el.textContent.trim() : 'Report';
            }

            function escHtml(s) {
                return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
            }

            function csvVal(v) {
                var s = String(v == null ? '' : v);
                if (/^\d{4}-\d{2}-\d{2}T/.test(s) || /^\d{4}-\d{2}-\d{2} /.test(s)) s = s.slice(0, 10);
                return '"' + s.replace(/"/g, '""') + '"';
            }

            function download(filename, content, type) {
                var blob = new Blob([content], { type: type + ';charset=utf-8;' });
                var a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(a.href);
            }

            function getExportRows() {
                // currentRows already carries date + dropdown + search filters (applyFilters)
                return (currentRows ? currentRows : allRows).slice();
            }

            function exportCsv() {
                var rows = getExportRows();
                var header = ['Sr.No'].concat(exportCols.map(function (c) { return c.label; })).join(',');
                var lines = rows.map(function (r, i) {
                    return (i + 1) + ',' + exportCols.map(function (c) { return csvVal(r[c.key]); }).join(',');
                });
                download(getReportTitle().replace(/[^\w-]+/g, '_') + '_' + new Date().toISOString().slice(0, 10) + '.csv', '\uFEFF' + header + '\n' + lines.join('\n'), 'text/csv');
            }

            function exportExcel() {
                var rows = getExportRows();
                var head = ['Sr.No'].concat(exportCols.map(function (c) { return escHtml(c.label); })).map(function (h) { return '<th>' + h + '</th>'; }).join('');
                var body = rows.map(function (r, i) {
                    var cells = exportCols.map(function (c) { return '<td>' + escHtml(r[c.key]) + '</td>'; });
                    return '<tr><td>' + (i + 1) + '</td>' + cells.join('') + '</tr>';
                }).join('');
                download(getReportTitle().replace(/[^\w-]+/g, '_') + '_' + new Date().toISOString().slice(0, 10) + '.xls', '\uFEFF' + '<table border="1"><tr>' + head + '</tr>' + body + '</table>', 'application/vnd.ms-excel');
            }

            function printTable() {
                var rows = getExportRows();
                var w = window.open('', '_blank');
                if (!w) {
                    Toastify({ text: 'Popup blocked. Allow popups to print.', duration: 3000, close: true, gravity: "top", position: "right", backgroundColor: "#f06548" }).showToast();
                    return;
                }
                var head = ['Sr.No'].concat(exportCols.map(function (c) { return escHtml(c.label); })).map(function (h) { return '<th>' + h + '</th>'; }).join('');
                var body = rows.map(function (r, i) {
                    var cells = exportCols.map(function (c) {
                        var v = r[c.key];
                        if (/^\d{4}-\d{2}-\d{2}T/.test(String(v == null ? '' : v)) || /^\d{4}-\d{2}-\d{2} /.test(String(v == null ? '' : v))) v = String(v).slice(0, 10);
                        return '<td>' + escHtml(v) + '</td>';
                    });
                    return '<tr><td>' + (i + 1) + '</td>' + cells.join('') + '</tr>';
                }).join('');
                w.document.write('<!DOCTYPE html><html><head><title>' + escHtml(getReportTitle()) + '</title>');
                w.document.write('<style>body{font-family:Arial,sans-serif;padding:20px}h2{margin-bottom:10px}' +
                    'table{border-collapse:collapse;width:100%;font-size:12px}th,td{border:1px solid #ddd;padding:5px 8px;text-align:left}' +
                    'th{background:#1e3a5f;color:#fff}</style></head><body>');
                w.document.write('<h2>' + escHtml(getReportTitle()) + ' Report</h2>');
                w.document.write('<p>' + rows.length + ' of ' + allRows.length + ' records</p>');
                w.document.write('<table border="1"><tr>' + head + '</tr>' + body + '</table>');
                w.document.write('</body></html>');
                w.document.close();
                w.focus();
                w.print();
            }

            document.getElementById('btn-excel').addEventListener('click', exportExcel);
            document.getElementById('btn-csv').addEventListener('click', exportCsv);
            document.getElementById('btn-print').addEventListener('click', printTable);

            // Rows per page
            document.getElementById('page-size').addEventListener('change', function () {
                this.blur();
                if (!grid) return;
                renderGrid(allColumns, currentRows);
            });

            // Record count
            function updateRecordCount(rows) {
                var el = document.getElementById('record-count');
                if (!el) return;
                el.textContent = (rows ? rows.length : allRows.length) + ' of ' + allRows.length + ' records';
            }

            function loadReportData(tableName) {
                document.getElementById('loading').style.display = 'block';
                document.getElementById('dynamicGrid').innerHTML = '';

                fetch(`/DynamicReport/GetReportData?tableName=${encodeURIComponent(tableName)}`)
                    .then(response => response.json())
                    .then(data => {
                        document.getElementById('loading').style.display = 'none';
                        if (data.success) {
                            allColumns = data.columns || [];
                            sourceColumns = Array.isArray(data.sourceColumns) && data.sourceColumns.length === allColumns.length
                                ? data.sourceColumns
                                : allColumns.slice();
                            allRows = data.rows || [];
                            currentRows = allRows;
                            allColumnTypes = data.columnTypes || [];
                            filterDefinitions = Array.isArray(data.filterFields) ? data.filterFields : [];
                            cardDefinitions = Array.isArray(data.cardFields) ? data.cardFields : [];
                            exportCols = allColumns.map(function (c, index) {
                                var label = String(sourceColumns[index] || c);
                                return { key: c, label: label };
                            });
                            var nameEl = document.getElementById('reportName');
                            if (nameEl && data.reportName) {
                                nameEl.textContent = data.reportName;
                                if (document.title) document.title = data.reportName;
                                var sEl = document.getElementById('reportSearch');
                                if (sEl) sEl.placeholder = 'Search in ' + data.reportName + '...';
                            }
                            initFilters();
                            renderCards(allColumns, allRows);
                            renderGrid(allColumns, allRows);
                            updateRecordCount(allRows);
                        } else {
                            Toastify({ text: data.message || "Failed to load report.", duration: 3000, close: true, gravity: "top", position: "right", backgroundColor: "#f06548" }).showToast();
                            document.getElementById('dynamicGrid').innerHTML = '<div class="alert alert-danger">Failed to load data.</div>';
                        }
                    })
                    .catch(err => {
                        document.getElementById('loading').style.display = 'none';
                        Toastify({ text: "Error connecting to server.", duration: 3000, close: true, gravity: "top", position: "right", backgroundColor: "#f06548" }).showToast();
                    });
            }

function renderGrid(columns, rows) {
                var gridWrapper = document.getElementById('dynamicGrid');
                if (!columns || columns.length === 0) {
                    gridWrapper.innerHTML = '<p class="text-muted">No data found.</p>';
                    return;
                }

                var limit = parseInt(document.getElementById('page-size').value, 10) || 10;

                var gridColumns = columns.map(function (c, index) {
                    return {
                        name: String(sourceColumns[index] || c),
                        id: c
                    };
                });

                var gridData = rows.map(row => {
                    let obj = {};
                    columns.forEach(col => {
                        obj[col] = row[col] === null || row[col] === undefined ? '' : row[col];
                    });
                    return obj;
                });

                try {
                    if (!grid) {
                        // create once ...
                        grid = new gridjs.Grid({
                            columns: gridColumns,
                            data: gridData,
                            pagination: {
                                enabled: true,
                                limit: limit
                            },
                            sort: true,
                            search: false, // custom #reportSearch box (applyFilters) hi single source of truth
                            className: {
                                table: 'table table-hover table-striped align-middle mb-0'
                            }
                        }).render(gridWrapper);
                    } else {
                        // ... refresh via config (avoids fragile re-instantiation)
                        grid = grid.updateConfig({
                            columns: gridColumns,
                            data: gridData,
                            pagination: {
                                enabled: true,
                                limit: limit
                            },
                            search: false
                        });
                        grid.forceRender();
                    }
                } catch (err) {
                    console.error('[DynRep] renderGrid error:', err);
                    gridWrapper.innerHTML = '<div class="alert alert-warning">Table render error: ' +
                        escHtml(err && err.message ? err.message : String(err)) +
                        '. Data is still available in CSV / Excel / Print.</div>';
                    return;
                }

                // Hide the default GridJS search box since we have our custom one
                setTimeout(() => {
                    var gridJsSearch = gridWrapper.querySelector('.gridjs-search');
                    if (gridJsSearch) {
                        gridJsSearch.style.display = 'none';
                    }
                }, 100);
            }

            // ============ Dynamic Summary Cards ============
            function nfmt(n) {
                return new Intl.NumberFormat('en-IN').format(Math.round(n * 100) / 100);
            }

            function distinctCount(col, rows) {
                var s = new Set();
                for (var i = 0; i < rows.length; i++) {
                    var v = rows[i][col];
                    if (v !== null && v !== undefined && String(v).trim() !== '') s.add(String(v).trim());
                }
                return s.size;
            }

            function sumNumeric(col, rows) {
                var t = 0;
                for (var i = 0; i < rows.length; i++) {
                    var v = rows[i][col];
                    if (v === null || v === undefined) continue;
                    var n = parseFloat(String(v).replace(/[^\d.\-]/g, ''));
                    if (isFinite(n)) t += n;
                }
                return t;
            }

            function isNumericCol(col, rows) {
                for (var i = 0; i < rows.length; i++) {
                    var v = rows[i][col];
                    if (v === null || v === undefined || String(v).trim() === '') continue;
                    return isFinite(parseFloat(String(v).replace(/[^\d.\-]/g, '')));
                }
                // Data nahi aaya (ya poora blank) - tab SP ke column type se decide karo.
                // Type column se aata hai, value se nahi, isliye empty data par bhi sahi rehta hai.
                return isNumericColumnType(getColumnType(col));
            }

            function isNumericColumnType(type) {
                return /int|double|decimal|single|float|long|short|byte|uint|ulong|ushort/.test(String(type || '').toLowerCase());
            }

            // KPI 2/3/4 - database (Kpi2/Kpi3/Kpi4) se. Value format: "Column" ya "Column|Custom Label"
            function resolveKpiCard(def, rows) {
                if (!def || !def.field) return null;

                var found = getColumnEntries(def.field);
                if (!found.length) return null;

                var col = found[0];
                // Note: column match ho gaya to card dikhega, chahe data na aaye.
                // Data khaali hone par value 0 rahega (SUM ya DISTINCT COUNT - type se decide).

                var numeric = isNumericCol(col, rows);
                var money = /amount|amt|mrp|wsp|price|cost|rate/i.test(col);

                return {
                    label: def.label ? def.label : ('Total ' + humanLabel(col)),
                    value: numeric ? sumNumeric(col, rows) : distinctCount(col, rows),
                    col: col,
                    calc: numeric ? 'SUM' : 'DISTINCT COUNT',
                    tone: money ? 'total' : 'qty',
                    icon: numeric
                        ? (money ? 'ri-money-dollar-circle-line' : 'ri-stack-line')
                        : 'ri-file-list-3-line'
                };
            }

            function chartSvg(color) {
                if (color === 'blue') {
                    return '<svg viewBox="0 0 24 24" fill="none"><rect x="0" y="12" width="4" height="12" rx="1.5" fill="#3b82f6" opacity="0.35"/><rect x="6" y="6" width="4" height="18" rx="1.5" fill="#3b82f6" opacity="0.65"/><rect x="12" y="2" width="4" height="22" rx="1.5" fill="#3b82f6"/><rect x="18" y="9" width="4" height="15" rx="1.5" fill="#3b82f6" opacity="0.5"/></svg>';
                }
                if (color === 'grey') {
                    return '<svg viewBox="0 0 18 24" fill="none"><rect x="0" y="10" width="4" height="14" rx="1.5" fill="#6b7280" opacity="0.4"/><rect x="6" y="2" width="4" height="22" rx="1.5" fill="#6b7280"/><rect x="12" y="7" width="4" height="17" rx="1.5" fill="#6b7280" opacity="0.7"/></svg>';
                }
                if (color === 'green') {
                    return '<svg viewBox="0 0 24 24" fill="none"><rect x="0" y="13" width="4" height="11" rx="1.5" fill="#10b981" opacity="0.4"/><rect x="6" y="5" width="4" height="19" rx="1.5" fill="#10b981" opacity="0.7"/><rect x="12" y="9" width="4" height="15" rx="1.5" fill="#10b981"/><circle cx="20" cy="4" r="2.5" fill="#10b981"/><rect x="18" y="11" width="4" height="13" rx="1.5" fill="#10b981" opacity="0.55"/></svg>';
                }
                return '<svg viewBox="0 0 18 24" fill="none"><rect x="0" y="14" width="4" height="10" rx="1.5" fill="#ff8c00" opacity="0.35"/><rect x="6" y="4" width="4" height="20" rx="1.5" fill="#ff8c00"/><rect x="12" y="8" width="4" height="16" rx="1.5" fill="#ff8c00" opacity="0.65"/></svg>';
            }

            function renderCards(columns, rows) {
                rows = rows || [];
                // columns khali ho tab bhi Card 1 (row count) dikhega; Card 2/3/4 apne aap chhupenge

                // KPI 1 - hamesha row count (fixed)
                var cards = [{
                    label: 'Total Records',
                    value: rows.length,
                    col: '-',
                    calc: 'ROW COUNT',
                    tone: 'total',
                    icon: 'ri-file-list-3-line'
                }];

                // KPI 2, 3, 4 - database se (Kpi2/Kpi3/Kpi4)
                var bySlot = {};
                cardDefinitions.forEach(function (d) { bySlot[d.slot] = d; });
                for (var s = 2; s <= 4; s++) {
                    cards.push(resolveKpiCard(bySlot[s], rows));
                }

                var colorMap = { total: 'orange', qty: 'blue', active: 'green', gst: 'orange' };
                var cardEls = document.getElementById('drcCards').querySelectorAll('.stat-card');

                for (var i = 0; i < cardEls.length; i++) {
                    var c = cards[i];
                    var cardEl = cardEls[i];
                    if (!cardEl) continue;

                    if (!c) {
                        cardEl.parentElement.classList.add('d-none');
                        continue;
                    }
                    cardEl.parentElement.classList.remove('d-none');

                    var color = colorMap[c.tone] || 'orange';
                    cardEl.className = 'card stat-card h-100 stat-' + color;
                    cardEl.querySelector('.avatar-title').className = 'avatar-title rounded-xl icon-44 bg-solid-' + color;
                    cardEl.querySelector('.avatar-title i').className = c.icon + ' text-white';
                    cardEl.querySelector('.stat-label').textContent = c.label;
                    cardEl.title = 'Column: ' + c.col + ' | Calculation: ' + c.calc;
                    cardEl.querySelector('.stat-label').title = '';
                    var valueEl = cardEl.querySelector('.stat-value');
                    valueEl.textContent = nfmt(c.value);
                    valueEl.title = '';
                    cardEl.querySelector('.chart-mini').innerHTML = chartSvg(color);
                }
            }

            // ============ Dynamic Filters ============
            function parseDate(v) {
                if (!v || v === '') return null;
                var d = new Date(v);
                return isNaN(d.getTime()) ? null : d;
            }

            function getFilterFieldName(item) {
                if (typeof item === 'string') return item;
                if (!item) return '';
                return item.field || item.FieldName || item.name || '';
            }

            function isFilterFieldVisible(item) {
                if (typeof item === 'string') return true;
                if (!item) return false;
                if (typeof item.visible === 'string') {
                    return ['false', '0', 'no', 'n', 'off'].indexOf(item.visible.trim().toLowerCase()) < 0;
                }
                return item.visible !== false;
            }

            function colSrcName(i) {
                return String(sourceColumns[i] == null ? allColumns[i] : sourceColumns[i]);
            }

            function normKey(s) {
                return String(s == null ? '' : s).replace(/[^A-Za-z0-9]/g, '').toLowerCase();
            }

            function getColumnEntries(name) {
                var out = [];
                if (!allColumns || !allColumns.length) return out;
                var requested = String(name == null ? '' : name).trim().toLowerCase();
                if (!requested) return out;
                var want = normKey(name);

                // Tier 1 - exact (original behaviour, always wins)
                for (var i = 0; i < allColumns.length; i++) {
                    if (colSrcName(i).trim().toLowerCase() === requested && out.indexOf(allColumns[i]) < 0) {
                        out.push(allColumns[i]);
                    }
                }
                if (out.length) return out;

                // Tier 2 - normalized (ignores spaces/underscores: "Client Name" <-> "Clientname")
                for (var j = 0; j < allColumns.length; j++) {
                    if (normKey(colSrcName(j)) === want && out.indexOf(allColumns[j]) < 0) {
                        out.push(allColumns[j]);
                    }
                }
                if (out.length) return out;

                // Tier 3 - contains ("Date" <-> "DocDate", "Category" <-> "Category1")
                for (var k = 0; k < allColumns.length; k++) {
                    if (normKey(colSrcName(k)).indexOf(want) >= 0 && out.indexOf(allColumns[k]) < 0) {
                        out.push(allColumns[k]);
                    }
                }
                return out;
            }

            function isDateColCandidate(col) {
                var vals = 0, parseable = 0;
                for (var i = 0; i < allRows.length; i++) {
                    var v = allRows[i][col];
                    if (v === null || v === undefined) continue;
                    vals++;
                    if (parseDate(v)) parseable++;
                }
                return vals > 0 && (parseable / vals) >= 0.6;
            }

            function getColumnType(col) {
                var index = allColumns.indexOf(col);
                return index >= 0 && allColumnTypes[index]
                    ? String(allColumnTypes[index]).toLowerCase()
                    : '';
            }

            function isDateColumn(col) {
                return getColumnType(col).indexOf('date') >= 0 || isDateColCandidate(col);
            }

            function detectDateCol() {
                for (var i = 0; i < filterDefinitions.length; i++) {
                    if (!isFilterFieldVisible(filterDefinitions[i])) continue;
                    var field = getFilterFieldName(filterDefinitions[i]);
                    var found = getColumnEntries(field);
                    for (var j = 0; j < found.length; j++) {
                        if (String(field).trim().toLowerCase() === 'date' || isDateColumn(found[j])) {
                            return found[j];
                        }
                    }
                }
                // Config name se koi date column na mile to koi bhi date column utha lo.
                for (var k = 0; k < allColumns.length; k++) {
                    if (isDateColumn(allColumns[k])) return allColumns[k];
                }
                return null;
            }

            function buildFilterOptions(col) {
                var seen = {};
                var vals = [];
                for (var i = 0; i < allRows.length; i++) {
                    var v = allRows[i][col];
                    if (v === null || v === undefined) continue;
                    var s = String(v).trim();
                    if (!s || seen[s]) continue;
                    seen[s] = 1;
                    vals.push(s);
                }
                vals.sort(function (a, b) { return a.localeCompare(b); });
                return vals;
            }

            function detectFilterCols() {
                var out = [];
                if (!allColumns || !allColumns.length || !filterDefinitions.length) return out;
                var usedCols = {};
                for (var i = 0; i < filterDefinitions.length; i++) {
                    if (!isFilterFieldVisible(filterDefinitions[i])) continue;
                    var field = getFilterFieldName(filterDefinitions[i]);
                    var found = getColumnEntries(field);
                    if (!found.length) continue;
                    var col = found[0];
                    var columnKey = String(col).trim().toLowerCase();
                    if (usedCols[columnKey] || col === dateCol || isDateColumn(col)) continue;
                    out.push({ col: col, label: field || col, options: buildFilterOptions(col) });
                    usedCols[columnKey] = 1;
                }
                return out;
            }


            function humanLabel(col) {
                var s = col.split(/[^A-Za-z0-9]+/).join(' ');
                return s.charAt(0).toUpperCase() + s.slice(1);
            }

            function initFilters() {
                dateCol = detectDateCol();
                var fromWrap = document.getElementById('drcFromWrap');
                var toWrap = document.getElementById('drcToWrap');
                if (dateCol) {
                    fromWrap.style.display = '';
                    toWrap.style.display = '';
                    document.getElementById('drcFromDate').value = '';
                    document.getElementById('drcToDate').value = '';
                } else {
                    fromWrap.style.display = 'none';
                    toWrap.style.display = 'none';
                }

                filterCols = [];
                choicesInstances = {};
                var mounts = document.getElementById('drcFilterMounts');
                var row = document.getElementById('drcFilterRow');
                row.innerHTML = '';
                if (allColumns && allColumns.length) {
                    var cols = detectFilterCols();
                    cols.forEach(function (res) {
                        var div = document.createElement('div');
                        div.className = 'col-6 col-lg-3';
                        var lbl = document.createElement('label');
                        lbl.className = 'form-label fs-label-sm';
                        lbl.textContent = humanLabel(res.label || res.col);
                        var sel = document.createElement('select');
                        sel.className = 'form-select drc-filter-select';
                        sel.dataset.col = res.col;
                        var allOpt = document.createElement('option');
                        allOpt.value = '__ALL__';
                        allOpt.textContent = 'All ' + humanLabel(res.label || res.col);
                        sel.appendChild(allOpt);
                        res.options.forEach(function (o) {
                            var opt = document.createElement('option');
                            opt.value = o;
                            opt.textContent = o;
                            sel.appendChild(opt);
                        });
                        sel.selectedIndex = 0;
                        div.appendChild(lbl);
                        div.appendChild(sel);
                        row.appendChild(div);
                        filterCols.push({ col: res.col, select: sel });
                        sel.addEventListener('change', applyFilters);
                        try {
                            choicesInstances[res.col] = new Choices(sel, {
                                searchEnabled: true,
                                searchFloor: 1,
                                shouldSort: false,
                                position: 'bottom',
                                itemSelectText: '',
                                placeholder: false
                            });
                        } catch (e) { }
                    });
                    mounts.style.display = filterCols.length ? '' : 'none';
                } else {
                    mounts.style.display = 'none';
                }
            }

            function applyFilters() {
                if (!allColumns.length || !allRows.length) return;
                var rows = allRows.slice();

                var fromVal = document.getElementById('drcFromDate').value;
                var toVal = document.getElementById('drcToDate').value;
                var from = fromVal ? parseDate(fromVal + 'T00:00:00') : null;
                var to = toVal ? parseDate(toVal + 'T23:59:59.999') : null;

                if ((from || to) && dateCol) {
                    rows = rows.filter(function (r) {
                        var d = parseDate(r[dateCol]);
                        if (!d) return false;
                        if (from && d < from) return false;
                        if (to && d > to) return false;
                        return true;
                    });
}

// dropdown filters (multi)
                filterCols.forEach(function (f) {
                    var fv;
                    var ch = choicesInstances[f.col];
                    if (ch && typeof ch.getValue === 'function') {
                        var got = ch.getValue(true);
                        fv = Array.isArray(got) ? (got.length ? String(got[0]) : '') : String(got || '');
                    } else {
                        fv = f.select.value;
                    }
                    if (!fv || fv === '__ALL__') return;
                    rows = rows.filter(function (r) {
                        var v = r[f.col];
                        return String(v === null || v === undefined ? '' : v).trim() === fv;
                    });
                });

// search keyword (same matching jo getExportRows() use karta hai)
                var kw = document.getElementById('reportSearch').value.trim().toLowerCase();
                if (kw) {
                    rows = rows.filter(function (r) {
                        for (var ci = 0; ci < allColumns.length; ci++) {
                            var cv = r[allColumns[ci]];
                            if (String(cv === null || cv === undefined ? '' : cv).toLowerCase().indexOf(kw) >= 0) return true;
                        }
                        return false;
                    });
                }

currentRows = rows;
                renderCards(allColumns, rows);
                renderGrid(allColumns, rows);
                updateRecordCount(rows);
            }
        });
    </script>
}

