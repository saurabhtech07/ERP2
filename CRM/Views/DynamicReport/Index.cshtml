@model IEnumerable<CRM.Models.ReportMenuItem>
@{
    ViewData["Title"] = ViewBag.ReportName;
}

@section styles {
<link href="~/assets/libs/gridjs/theme/mermaid.min.css" rel="stylesheet" type="text/css" />
<link href="~/css/dynamic-report-actions.css?v=2" rel="stylesheet" type="text/css" />
    <link href="~/assets/libs/toastify-js/src/toastify.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/libs/choices.js/public/assets/styles/choices.min.css" rel="stylesheet" type="text/css" />
    <link href="~/css/item-master.css?v=2" rel="stylesheet" type="text/css" />
    <style>
        .fs-label-sm {
            display: block;
            font-size: 10.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.45px;
            color: #64748b;
            margin-bottom: 0.35rem;
        }
.filter-panel input[type="date"],
        .filter-panel .form-select {
            min-height: 38px;
        }

        #dynamicGrid {
            max-height: calc(100vh - 265px);
            min-height: 470px;
            overflow: auto !important;
            border: 1px solid #e9ecef;
            border-radius: 0.6rem;
            background: #ffffff;
            scrollbar-gutter: stable;
        }

        #dynamicGrid .gridjs-wrapper {
            max-height: none !important;
            min-height: 0 !important;
            overflow: visible !important;
            border: 0 !important;
            border-radius: 0 !important;
            box-shadow: none !important;
        }

        #dynamicGrid .gridjs-container,
        #dynamicGrid .gridjs-content {
            display: block !important;
            width: 100% !important;
            overflow: visible !important;
        }

        #dynamicGrid .gridjs-table,
        #dynamicGrid .gridjs-table table {
            width: max-content;
            min-width: 100%;
            border-collapse: separate !important;
            border-spacing: 0;
        }

        #dynamicGrid .gridjs-thead {
            display: table-header-group;
            position: sticky;
            top: 0;
            z-index: 10;
            background: #1e3a5f;
        }

        #dynamicGrid .gridjs-thead th {
            position: sticky !important;
            top: 0;
            z-index: 11;
        }

        #dynamicGrid .gridjs-thead th {
            background-color: #1e3a5f !important;
            color: #fff !important;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 11px 12px;
            border: none !important;
            white-space: nowrap;
            overflow: visible;
        }

        #dynamicGrid .gridjs-thead th .gridjs-th-content {
            overflow: visible;
            text-overflow: clip;
        }

        #dynamicGrid .gridjs-thead th:hover {
            background-color: #274b76 !important;
        }

        #dynamicGrid .gridjs-table {
            margin: 0;
        }

        #dynamicGrid .gridjs-table tbody td {
            vertical-align: middle;
            padding: 10px 12px;
        }

        #dynamicGrid .gridjs-table tbody tr {
            transition: background-color 0.15s ease;
        }

        #dynamicGrid .gridjs-table tbody tr:hover td {
            background-color: #eef4fb;
        }

        #dynamicGrid .gridjs-pagination {
            justify-content: flex-end;
            padding-top: 0.75rem;
        }

        #dynamicGrid button.gridjs-pages button {
            border-radius: 0.375rem;
            margin: 0 0.125rem;
        }

        #dynamicGrid .gridjs-footer {
            background: var(--vz-card-bg);
        }

#dynamicGrid .gridjs-th-sort:hover,
        #dynamicGrid .gridjs-th-sort:focus {
            background: none;
        }
    </style>
    <style>
        /* ================================================================
           POLISH - Pure CSS, logic/DOM untouched.
           Reverse ke liye bas ye poora block delete kar dena.
           ================================================================ */

        /* ---------- Filter panel ---------- */
        .filter-panel {
            position: relative;
            border: 1px solid var(--drc-border, #e2e8f0);
            border-radius: 12px;
            box-shadow: 0 10px 26px -20px rgba(15, 23, 42, 0.42);
            overflow: visible;
        }
        .filter-panel::before {
            content: "";
            position: absolute;
            left: 0;
            top: 12px;
            bottom: 12px;
            width: 4px;
            border-radius: 999px;
            background: linear-gradient(180deg,
                var(--dr-primary, #405189) 0%,
                color-mix(in srgb, var(--vz-primary, #405189) 78%, #06b6d4) 50%,
                color-mix(in srgb, var(--vz-primary, #405189) 78%, #10b981) 100%);
        }
        .filter-panel .fs-label {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 800;
            letter-spacing: 0;
            color: var(--dr-primary, #405189);
            margin-bottom: 0;
        }
        .drc-filter-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 0.65rem 0.8rem;
            border-left: 4px solid var(--dr-primary, #405189);
            border-bottom: 1px solid var(--drc-border, #e2e8f0);
            border-radius: 8px;
            background: color-mix(in srgb, var(--dr-primary, #405189) 8%, var(--drc-surface, #fff));
        }
        .drc-filter-heading .fs-label { margin-bottom: 0; }
        .drc-filter-controls {
            display: flex;
            flex-wrap: wrap;
            align-items: end;
            gap: 0.75rem;
            padding-top: 0.75rem;
        }
        #drcFilterMounts:not([hidden]),
        #drcFilterRow { display: contents; }
        #drcFilterMounts[hidden] { display: none !important; }
        .drc-filter-item,
        .drc-date-field { flex: 1 1 180px; min-width: 0; }
        #drcFilterRow .drc-filter-item:only-child { flex: 0 1 280px; }
        .drc-filter-item .choices {
            width: 100%;
            margin-bottom: 0;
        }
        .drc-filter-item .choices,
        .drc-filter-item .form-select { width: 100%; }
        .drc-date-range {
            display: contents;
        }
        .drc-filter-item > .form-label,
        .drc-date-field > .form-label {
            margin-bottom: 0.35rem;
            color: var(--drc-text, #334155);
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
        }
        .drc-date-field input[type="date"] { width: 100%; }
        #drcDateRange[hidden] { display: none !important; }
        .drc-filter-reset {
            flex: 0 0 auto;
            min-height: 42px;
            align-self: end;
            border-radius: 10px;
            font-weight: 700;
        }
        .drc-filter-toggle {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            padding: 0;
            border: 1px solid #dbe3ed;
            border-radius: 8px;
            background: #fff;
            color: var(--dr-primary, #405189);
            font-size: 20px;
            line-height: 1;
        }
        .drc-filter-toggle:hover { background: #eef4fb; }
        #drcFilterBody[hidden] { display: none !important; }
        .filter-panel .fs-label i { color: #06b6d4; font-size: 14px; }
        .filter-panel .form-label,
        .filter-panel .fs-label-sm { font-weight: 600; color: #475569; }

        .filter-panel input[type="date"],
        .filter-panel .form-select,
        .filter-panel .choices__inner {
            height: 42px;
            min-height: 42px;
            border-radius: 10px;
            border-color: var(--drc-border, #dbe3ed);
            background: #f1f4f9;
            transition: border-color .18s ease, box-shadow .18s ease;
        }
        .filter-panel input[type="date"]:focus,
        .filter-panel .form-select:focus,
        .filter-panel .choices.is-focused .choices__inner,
        .filter-panel .choices.is-open .choices__inner {
            border-color: #405189 !important;
            box-shadow: 0 0 0 3px rgba(64, 81, 137, 0.14);
        }
        .filter-panel .choices__inner {
            padding: 0.5rem 0.75rem;
        }
        .filter-panel .choices__list--dropdown {
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            box-shadow: 0 16px 34px -14px rgba(15, 23, 42, 0.22);
            margin-top: 5px;
            z-index: 20;
        }
        .filter-panel .choices.is-open { z-index: 10; }
        .filter-panel .choices__list--dropdown .choices__item--selectable.is-highlighted {
            background: #eef4fb;
        }

        /* ---------- Search (pill) ---------- */
        #drcFiltersSection[hidden] { display: none !important; }
        #reportSearch {
            border-radius: 9px;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05);
        }
        #reportSearch:focus {
            border-color: #405189;
            box-shadow: 0 0 0 3px rgba(64, 81, 137, 0.14);
        }
        #reportSearch:focus ~ .search-icon { color: #405189; }
        .search-icon { color: #94a3b8; }

        /* ---------- Action buttons ---------- */
        #btn-excel, #btn-csv, #btn-print { border-radius: 9px; }
        #btn-excel { box-shadow: 0 8px 16px -10px rgba(18, 183, 106, 0.65); }
        #btn-csv   { box-shadow: 0 8px 16px -10px rgba(59, 130, 246, 0.65); }
        #btn-print { box-shadow: 0 8px 16px -10px rgba(139, 92, 246, 0.65); }
        .drc-filter-reset:hover { background: #f1f5f9; border-color: #dbe3ed; }


/* ---------- Cards (corporate KPI style - full revamp) ---------- */
        #drcCards { margin-top: 0.5rem; }
        #drcCards .stat-card {
            position: relative;
            overflow: hidden;
            border: 1px solid #e6eaf0;
            border-radius: 14px;
            background: #ffffff;
            box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04), 0 8px 24px -14px rgba(16, 24, 40, 0.10);
            transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
        }
        #drcCards .stat-card:hover {
            transform: translateY(-3px);
            border-color: #d8dfe9;
            box-shadow: 0 2px 4px rgba(16, 24, 40, 0.05), 0 18px 34px -16px rgba(16, 24, 40, 0.18);
        }

        /* ---- Master theme ke saath matching ----
           Ye page Velzon ke --vz-primary se chalata hai, to customizer ka
           colour badalte hi cards + grid header + filter ek saath badhte hain.
           Sirf ek jagah define hai, isliye page ka look hamesha consistent
           rehta hai - koi element peeche na chhoode. */

        /* Velzon sirf [data-theme-colors=green|purple|blue] par --vz-primary
           define karta hai. Customizer ka pehla swatch "default" hai, aur uske
           liye koi rule nahi - to var(--vz-primary) undefined reh jata tha aur
           cards kabhi nahi badlite. Yahan "default" ke liye Velzon ka apna
           navy (#405189) set kar rahe hain; green/purple/blue select karne par
           Velzon ki apni rule inhe override kar degi (specificity zyada hai). */
        [data-theme-colors="default"] {
            --vz-primary: #405189;
            --vz-primary-rgb: 64, 81, 137;
        }

        #drcCards .stat-card {
            position: relative;
            overflow: hidden;
            border: 1px solid #e6eaf0;
            border-radius: 14px;
            background: #ffffff;
            box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04), 0 8px 24px -14px rgba(16, 24, 40, 0.10);
            transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
        }
        #drcCards .stat-card:hover {
            transform: translateY(-3px);
            border-color: #d8dfe9;
            box-shadow: 0 2px 4px rgba(16, 24, 40, 0.05), 0 18px 34px -16px rgba(16, 24, 40, 0.18);
        }

        /* old gradient bar + radial glow hataya */
        #drcCards .stat-card::after {
            display: none !important;
            background: transparent !important;
        }
        /* thin tone accent on the left */
        #drcCards .stat-card::before {
            content: "" !important;
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            border-radius: 0;
            opacity: 1;
            background: transparent !important;
        }
        #drcCards .stat-orange::before { background: #f59e0b !important; }
        #drcCards .stat-blue::before   { background: #3b82f6 !important; }
        #drcCards .stat-red::before    { background: #e11d48 !important; }
        #drcCards .stat-grey::before   { background: #64748b !important; }
        #drcCards .stat-green::before  { background: #10b981 !important; }
        #drcCards .stat-violet::before { background: #8b5cf6 !important; }

        /* Mini chart ka rang = us tone ka strong (icon) colour. Fixed hai, to
           theme customizer par chart ka rang nahi badlega. */
        #drcCards .stat-orange { --tone-ink: #f59e0b; }
        #drcCards .stat-blue   { --tone-ink: #3b82f6; }
        #drcCards .stat-red    { --tone-ink: #e11d48; }
        #drcCards .stat-grey   { --tone-ink: #64748b; }
        #drcCards .stat-green  { --tone-ink: #10b981; }
        #drcCards .stat-violet { --tone-ink: #8b5cf6; }

        #drcCards .stat-card .card-body {
            padding: 0.85rem 1rem;
            gap: 8px;
        }
        #drcCards .stat-card .avatar-title {
            width: 46px;
            height: 46px;
            min-width: 46px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: none !important;
            outline: none !important;
        }
        #drcCards .stat-card .avatar-title i { font-size: 22px; }
        #drcCards .stat-orange .avatar-title { background: #fff5e6 !important; }
        #drcCards .stat-orange .avatar-title i { color: #f59e0b !important; }
        #drcCards .stat-blue .avatar-title { background: #eef4ff !important; }
        #drcCards .stat-blue .avatar-title i { color: #3b82f6 !important; }
        #drcCards .stat-red .avatar-title { background: #fff1f2 !important; }
        #drcCards .stat-red .avatar-title i { color: #e11d48 !important; }
        #drcCards .stat-grey .avatar-title { background: #f1f5f9 !important; }
        #drcCards .stat-grey .avatar-title i { color: #64748b !important; }
        #drcCards .stat-green .avatar-title { background: #ecfdf5 !important; }
        #drcCards .stat-green .avatar-title i { color: #10b981 !important; }
        #drcCards .stat-violet .avatar-title { background: #f5f3ff !important; }
        #drcCards .stat-violet .avatar-title i { color: #8b5cf6 !important; }

        #drcCards .stat-card .stat-label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            color: #64748b;
            line-height: 1.25;
            margin-bottom: 2px;
        }
        #drcCards .stat-card .stat-value {
            font-size: 20px;
            font-weight: 800;
            letter-spacing: -0.5px;
            color: #0f172a;
            line-height: 1.1;
        }
        #drcCards .stat-card .chart-mini { flex-shrink: 0; opacity: 0.85; }
        #drcCards .stat-card .chart-mini svg { width: 38px; height: 34px; }

        /* soft entrance */
        #drcCards .stat-card { animation: drcCardIn .45s ease both; }
        #drcCards .stat-card:nth-child(2) { animation-delay: .06s; }
        #drcCards .stat-card:nth-child(3) { animation-delay: .12s; }
        #drcCards .stat-card:nth-child(4) { animation-delay: .18s; }
        @@keyframes drcCardIn {
            from { opacity: 0; transform: translateY(8px); }
            to   { opacity: 1; transform: none; }
        }

        /* ---------- Cards loading state (sidebar click / first paint) ----------
           Sidebar ke link full page navigate karte hain, isliye server se aane
           tak ye static markup hi dikhta hai. Structure wahi rakha hai jo
           renderCards() bharta hai, isliye load hote hi text/classes replace
           ho jate hain - sirf shimmer bars dikhte rahne hain. */
        #drcCards .stat-card.stat-skeleton .stat-label,
        #drcCards .stat-card.stat-skeleton .stat-value {
            position: relative;
            overflow: hidden;
            background: #eef2f7;
            color: transparent;
            border-radius: 6px;
            text-indent: -9999px;
        }
        #drcCards .stat-card.stat-skeleton .stat-label {
            width: 78px;
            height: 10px;
            margin-bottom: 7px;
        }
        #drcCards .stat-card.stat-skeleton .stat-value {
            width: 58px;
            height: 24px;
        }
        #drcCards .stat-card.stat-skeleton .avatar-title {
            position: relative;
            overflow: hidden;
            background: #e6ebf2 !important;
            box-shadow: none !important;
        }
        #drcCards .stat-card.stat-skeleton .avatar-title i { color: transparent !important; }
        #drcCards .stat-card.stat-skeleton .chart-mini {
            position: relative;
            overflow: hidden;
            /* Real card ke chart-mini (svg 38x34) ke barabar. */
            width: 38px;
            height: 34px;
            border-radius: 8px;
            background: #e6ebf2;
        }
        #drcCards .stat-card.stat-skeleton:hover {
            transform: none;
            border-color: #eef1f6;
            box-shadow: 0 1px 2px rgba(16, 24, 40, .04), 0 8px 24px -18px rgba(16, 24, 40, .22);
        }

        #drcCards .stat-skeleton .stat-label::after,
        #drcCards .stat-skeleton .stat-value::after,
        #drcCards .stat-skeleton .chart-mini::after,
        #drcCards .stat-skeleton .avatar-title::after {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.9) 50%, transparent 100%);
            animation: drcCardShimmer 1.25s ease-in-out infinite;
        }
        #drcCards .stat-skeleton .stat-label::after    { animation-delay: .1s; }
        #drcCards .stat-skeleton .stat-value::after   { animation-delay: .22s; }
        #drcCards .stat-skeleton .avatar-title::after { animation-delay: .04s; }
        #drcCards .stat-skeleton .chart-mini::after   { animation-delay: .3s; }
        @@keyframes drcCardShimmer {
            from { transform: translateX(-100%); }
            to   { transform: translateX(100%); }
        }

        /* ---------- Premium loading shimmer ---------- */
        #loading .skeleton-card {
            border: 1px solid #e9ecef;
            border-radius: 0.6rem;
            padding: 0.85rem 1rem;
            background: #ffffff;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
            overflow: hidden;
        }
        #loading .skeleton {
            position: relative;
            background: #eef1f5;
            border-radius: 6px;
            height: 14px;
            margin-bottom: 10px;
            overflow: hidden;
        }
        #loading .skeleton-head { height: 18px; width: 42%; margin-bottom: 16px; }
        #loading .skeleton-sk-1 { width: 100%; }
        #loading .skeleton-sk-2 { width: 78%; }
        #loading .skeleton-sk-3 { width: 92%; }
        #loading .skeleton-sk-4 { width: 64%; }
        #loading .skeleton-sk-5 { width: 85%; }
        #loading .skeleton::after {
            content: "";
            position: absolute;
            inset: 0;
            transform: translateX(-100%);
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.7), transparent);
            animation: skeletonShimmer 1.4s ease infinite;
        }
        @@keyframes skeletonShimmer { to { transform: translateX(100%); } }

        /* ---------- Search clear (x) ---------- */
        #reportSearch { padding-right: 2.4rem; }
        .search-clear {
            right: 0.45rem;
            width: 22px;
            height: 22px;
            border: none;
            border-radius: 50%;
            background: transparent;
            color: #94a3b8;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            padding: 0;
            line-height: 1;
            transition: color .15s ease, background .15s ease;
        }
        .search-clear i { font-size: 14px; }
        .search-clear:hover { color: #f06548; background: #f1f5f9; }

        /* ---------- Pagination ---------- */
        #dynamicGrid .gridjs-pagination .gridjs-summary { color: #64748b; font-weight: 500; font-size: 12.5px; }
        #dynamicGrid .gridjs-pagination .gridjs-pages button {
            border-radius: 8px;
            min-width: 30px;
            height: 30px;
            padding: 0 8px;
            box-sizing: border-box;
            border: 1px solid #e2e8f0;
            background: #ffffff;
            color: #475569;
            font-size: 12.5px;
            line-height: 1;
            transition: all .15s ease;
        }
        #dynamicGrid .gridjs-pagination .gridjs-pages button:hover:not(:disabled) {
            background: #eef4fb;
            border-color: #c3cbdc;
            color: #405189;
        }
        #dynamicGrid .gridjs-pagination .gridjs-pages button.gridjs-currentPage {
            background: #405189 !important;
            border-color: #405189 !important;
            color: #ffffff !important;
            font-weight: 600;
            box-shadow: 0 4px 10px -4px rgba(64, 81, 137, 0.5);
        }
        #dynamicGrid .gridjs-pagination .gridjs-pages button:disabled { opacity: 0.55; }

        /* ---------- Grid header + record pill ---------- */
        #reportTableSection .card-header {
            background: #f9fafc;
            border-bottom: 1px solid #eceff4;
        }
        .drc-report-title { display: flex; align-items: center; gap: 10px; min-width: 0; }
        .report-icon-chip {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            flex-shrink: 0;
            border-radius: 10px;
            background: #eef1f9;
            color: #405189;
            font-size: 16px;
        }
        #reportName {
            font-weight: 800;
            color: #0f172a;
            font-size: 15px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .record-count-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: #eef2f7;
            color: #64748b;
            font-size: 11.5px;
            font-weight: 700;
            letter-spacing: 0.3px;
            padding: 3px 10px;
            border-radius: 999px;
            border: 1px solid #e2e8f0;
            white-space: nowrap;
        }
        .drc-table-toolbar {
            display: grid;
            grid-template-columns: minmax(270px, 1fr) auto minmax(190px, 1fr);
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            border-bottom: 1px solid #eceff4;
        }
        .drc-page-size,
        .drc-export-buttons,
        .drc-search { min-width: 0; }
        .drc-page-size { display: flex; align-items: center; gap: 8px; white-space: nowrap; }
        .drc-page-size select { width: 78px; }
        .drc-export-buttons { display: flex; justify-content: center; gap: 8px; }
        .drc-export-buttons .btn-action {
            border: 1px solid transparent;
            padding: 0.4rem 0.9rem;
            border-radius: 8px;
            color: #fff;
            font-size: 13px;
            font-weight: 600;
            min-height: 38px;
            transition: all 0.2s ease;
        }
        .drc-export-buttons .btn-excel { background: linear-gradient(135deg, #12b76a, #0f9d58); }
        .drc-export-buttons .btn-csv { background: linear-gradient(135deg, #3b82f6, #06b6d4); }
        .drc-export-buttons .btn-print { background: linear-gradient(135deg, #8b5cf6, #a855f7); }
        .drc-export-buttons .btn-action:hover {
            background: var(--dr-primary-dk);
            border-color: var(--dr-primary-dk);
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 8px 16px -8px rgba(15, 23, 42, 0.4);
        }
        .drc-search { justify-self: end; width: min(100%, 280px); }
        @@media (max-width: 767.98px) {
            .drc-table-toolbar { grid-template-columns: minmax(0, 1fr) auto; padding: 12px; }
            .drc-search { grid-column: 1 / -1; justify-self: stretch; width: 100%; }
            .drc-page-size { flex-wrap: wrap; }
            .drc-filter-item,
            .drc-date-field { flex-basis: calc(50% - 0.375rem); }
            html[data-bs-theme="dark"] .filter-panel input[type="date"],
            html[data-bs-theme="dark"] .filter-panel .form-select,
            html[data-bs-theme="dark"] .filter-panel .choices__inner { background: var(--drc-surface-muted); }
        }
    </style>
    <style>
        /* ===== THEME-AWARE ACCENT LAYER (appended) =====
           The hardcoded navy accents (#1e3a5f / #405189 / #3b82f6) in the
            style blocks above are intentionally left untouched. Everything here
            re-points them at Velzon's --vz-primary-rgb so this page follows the
            Theme Customizer. KPI card tones bhi upar (line ~254) --vz-primary se
            mix hote hain, isliye cards aur grid header customizer par ek saath
            react karte hain.
            Delete this block to revert. Tag: safety-before-theme-accent */

        :root {
            --drc-surface: var(--vz-secondary-bg, var(--bs-body-bg, #ffffff));
            --drc-surface-muted: var(--vz-tertiary-bg, var(--bs-secondary-bg, #f3f6f9));
            --drc-text: var(--vz-body-color, var(--bs-body-color, #495057));
            --drc-muted: var(--vz-secondary-color, var(--bs-secondary-color, #74788d));
            --drc-border: var(--vz-border-color, var(--bs-border-color, #e9ecef));
            /* Fallback 64,81,137 = Velzon ka default navy (#405189). Pehle yahan
               30,58,95 tha, jo customizer ke "default" swatch se match nahi
               karta tha - isliye grid header/cards ka colour theme se alag tha. */
            --dr-primary:     rgb(var(--vz-primary-rgb, 64, 81, 137));
            --dr-primary-dk:  color-mix(in srgb, rgb(var(--vz-primary-rgb, 64, 81, 137)) 80%, #000);
            --dr-primary-lt:  color-mix(in srgb, rgb(var(--vz-primary-rgb, 64, 81, 137)) 72%, #fff);
            --dr-tint:        color-mix(in srgb, rgb(var(--vz-primary-rgb, 64, 81, 137)) 12%, var(--drc-surface));
            --dr-tint-bd:     color-mix(in srgb, rgb(var(--vz-primary-rgb, 64, 81, 137)) 30%, var(--drc-surface));
            --dr-grad:        linear-gradient(135deg, var(--dr-primary-dk) 0%, var(--dr-primary) 100%);
        }

        /* ---- Grid table header ---- */
        /* Cards aur table header ek hi master theme (--vz-primary) se aate
           hain, isliye customizer par dono ek saath badhte hain. */
        #dynamicGrid .gridjs-table tbody tr:hover td { background-color: var(--dr-tint); }

        /* ---- Filter panel ---- */
        .filter-panel .fs-label { color: var(--dr-primary); }
        .filter-panel .fs-label i { color: var(--dr-primary-lt); }
        .filter-panel input[type="date"]:focus,
        .filter-panel .form-select:focus,
        .filter-panel .choices.is-focused .choices__inner,
        .filter-panel .choices.is-open .choices__inner {
            border-color: var(--dr-primary) !important;
            box-shadow: 0 0 0 3px rgba(var(--vz-primary-rgb, 64, 81, 137), 0.14);
        }
        .filter-panel .choices__list--dropdown .choices__item--selectable.is-highlighted {
            background: var(--dr-tint);
        }

        /* ---- Search pill ---- */
        #reportSearch:focus {
            border-color: var(--dr-primary);
            box-shadow: 0 0 0 3px rgba(var(--vz-primary-rgb, 64, 81, 137), 0.14);
        }
        #reportSearch:focus ~ .search-icon { color: var(--dr-primary); }

        /* ---- KPI cards: tones upar --vz-primary se derive ho rahe hain, isliye
               customizer ka colour badalte hi cards bhi react karte hain. ---- */
        /* Grid header ko bhi wahi treatment diya hai, taaki cards aur table
           ek hi master theme se aayein. Velzon ke default header ko override
           karke --vz-primary-rgb se gradient banaya gaya hai. */
        #dynamicGrid .gridjs-thead {
            background: var(--dr-grad) !important;
        }
        #dynamicGrid .gridjs-thead th {
            background-color: transparent !important;
            color: #fff !important;
        }
        #dynamicGrid .gridjs-thead th:hover { background-color: var(--dr-primary-dk) !important; }
        #dynamicGrid .gridjs-thead th .gridjs-sort { filter: brightness(0) invert(1); }
        #dynamicGrid .gridjs-thead th.gridjs-th-sortable:hover { color: #fff !important; }

        /* ---- Grid pagination ---- */
        #dynamicGrid .gridjs-pagination .gridjs-pages button:hover:not(:disabled) {
            background: var(--dr-tint);
            border-color: var(--dr-tint-bd);
            color: var(--dr-primary);
        }
        #dynamicGrid .gridjs-pagination .gridjs-pages button.gridjs-currentPage {
            background: var(--dr-primary) !important;
            border-color: var(--dr-primary) !important;
            box-shadow: 0 4px 10px -4px rgba(var(--vz-primary-rgb, 64, 81, 137), 0.5);
        }

        /* ---- Report title chip ---- */
        .report-icon-chip {
            background: var(--dr-tint);
            color: var(--dr-primary);
        }

        .filter-panel,
        #reportTableSection .table-panel,
        #drcCards .stat-card {
            background: var(--drc-surface) !important;
            border-color: var(--drc-border) !important;
            color: var(--drc-text);
        }

        #reportTableSection .card-header,
        .drc-table-toolbar {
            background: var(--drc-surface-muted);
            border-color: var(--drc-border);
        }

        #dynamicGrid {
            background: var(--drc-surface);
            border-color: var(--drc-border);
        }

        #dynamicGrid .gridjs-wrapper,
        #dynamicGrid .gridjs-container,
        #dynamicGrid .gridjs-content,
        #dynamicGrid .gridjs-footer {
            background: var(--drc-surface);
            color: var(--drc-text);
        }

        #dynamicGrid .gridjs-tbody,
        #dynamicGrid td.gridjs-td {
            background: var(--drc-surface) !important;
            border-color: var(--drc-border) !important;
            color: var(--drc-text) !important;
        }

        #dynamicGrid .gridjs-tr:nth-child(even) td.gridjs-td {
            background: var(--drc-surface-muted) !important;
        }

        #dynamicGrid .gridjs-tr:hover td.gridjs-td {
            background: color-mix(in srgb, var(--dr-primary) 18%, var(--drc-surface)) !important;
        }

        #dynamicGrid .gridjs-container,
        #dynamicGrid .gridjs-pagination .gridjs-summary,
        #drcCards .stat-label,
        .filter-panel .form-label,
        .filter-panel .fs-label-sm {
            color: var(--drc-muted);
        }

        #dynamicGrid .gridjs-pagination .gridjs-pages button:not(.gridjs-currentPage) {
            background: var(--drc-surface);
            border-color: var(--drc-border);
            color: var(--drc-text);
        }

        #dynamicGrid .gridjs-pagination .gridjs-pages button:hover:not(:disabled):not(.gridjs-currentPage) {
            background: var(--drc-surface-muted);
            border-color: var(--dr-primary);
            color: var(--drc-text);
        }

        #drcCards .stat-value,
        #reportName {
            color: var(--drc-text);
        }

        #drcCards .stat-card .avatar-title {
            background: color-mix(in srgb, var(--tone-ink) 16%, var(--drc-surface)) !important;
        }

        .record-count-pill {
            background: var(--drc-surface-muted);
            border-color: var(--drc-border);
            color: var(--drc-muted);
        }

        .drc-filter-toggle {
            background: var(--drc-surface-muted);
            border-color: var(--drc-border);
            color: var(--dr-primary-lt);
        }

        .drc-filter-toggle:hover,
        #btn-clear:hover {
            background: color-mix(in srgb, var(--dr-primary) 18%, var(--drc-surface)) !important;
            border-color: var(--dr-primary);
            color: var(--drc-text);
        }

        .filter-panel input[type="date"],
        .filter-panel .form-select,
        .filter-panel .choices__inner,
        .filter-panel .choices__list--dropdown,
        .filter-panel .choices__list[aria-expanded] {
            background: var(--drc-surface-muted);
            border-color: var(--drc-border);
            color: var(--drc-text);
        }

        .filter-panel .choices__list--dropdown .choices__item,
        .filter-panel .choices__list[aria-expanded] .choices__item {
            color: var(--drc-text);
        }

        .filter-panel .choices__list--dropdown .choices__item--selectable.is-highlighted,
        .filter-panel .choices__list[aria-expanded] .choices__item--selectable.is-highlighted {
            background: var(--dr-tint);
            color: var(--drc-text);
        }

        html[data-bs-theme="dark"] .filter-panel .fs-label {
            color: var(--dr-primary-lt);
        }

        .filter-panel .drc-filter-item .form-select,
        .filter-panel .drc-filter-item .choices__inner,
        .filter-panel .drc-date-field input[type="date"] {
            background: #f1f4f9;
            height: 42px;
            min-height: 42px;
            border: 1px solid var(--drc-border);
            border-radius: 10px;
        }

        html[data-bs-theme="dark"] .filter-panel .drc-filter-item .form-select,
        html[data-bs-theme="dark"] .filter-panel .drc-filter-item .choices__inner,
        html[data-bs-theme="dark"] .filter-panel .drc-date-field input[type="date"] {
            background: var(--drc-surface-muted);
        }
    </style>
}

