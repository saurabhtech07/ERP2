<!-- Summary stat cards -->
<div class="row g-3 mb-3">
    <div class="col-6 col-xl-3">
        <div class="cm-stat-card">
            <div class="cm-stat-icon cm-stat-total"><i class="ri-briefcase-4-line"></i></div>
            <div class="cm-stat-body">
                <span class="cm-stat-label">Total Job Orders</span>
                <h4 class="cm-stat-value"><span id="joStatTotalJobs">0</span></h4>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="cm-stat-card">
            <div class="cm-stat-icon cm-stat-gst"><i class="ri-ruler-2-line"></i></div>
            <div class="cm-stat-body">
                <span class="cm-stat-label">Total Job Qty</span>
                <h4 class="cm-stat-value"><span id="joStatJobQty">0</span><span class="cm-stat-unit">PCS</span></h4>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="cm-stat-card">
            <div class="cm-stat-icon cm-stat-active"><i class="ri-tools-line"></i></div>
            <div class="cm-stat-body">
                <span class="cm-stat-label">Total Cut Qty</span>
                <h4 class="cm-stat-value"><span id="joStatCutQty">0</span><span class="cm-stat-unit">PCS</span></h4>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="cm-stat-card">
            <div class="cm-stat-icon cm-stat-inactive"><i class="ri-stack-line"></i></div>
            <div class="cm-stat-body">
                <span class="cm-stat-label">Balance Cut Qty</span>
                <h4 class="cm-stat-value"><span id="joStatBalCut">0</span><span class="cm-stat-unit">PCS</span></h4>
            </div>
        </div>
    </div>
</div>