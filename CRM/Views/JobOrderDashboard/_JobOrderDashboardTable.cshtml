<!-- Data grid card -->
<div class="row">
    <div class="col-12">
        <div class="card cm-card">

            <div class="card-body">

                <!-- Toolbar -->
                <div class="cm-toolbar">
                    <div class="cm-pg-control">
                        <span class="cm-pg-label">Show</span>
                        <div class="cm-select-wrap">
                            <select id="joPageSizeSelect" class="cm-size-select">
                                <option value="10" selected>10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                                <option value="100">100</option>
                            </select>
                            <i class="ri-arrow-down-s-line cm-select-caret"></i>
                        </div>
                        <span class="cm-pg-label">entries</span>
                    </div>

                    <div class="cm-export">
                        <button type="button" class="cm-export-btn cm-export-excel" onclick="exportToExcel()" title="Download as Excel (.xls)">
                            <span class="cm-export-ico"><i class="ri-file-excel-2-line"></i></span> Excel
                        </button>
                        <button type="button" class="cm-export-btn cm-export-csv" onclick="exportToCSV()" title="Download as CSV">
                            <span class="cm-export-ico"><i class="ri-file-text-line"></i></span> CSV
                        </button>
                        <button type="button" class="cm-export-btn cm-export-print" onclick="printTable()" title="Print records">
                            <span class="cm-export-ico"><i class="ri-printer-line"></i></span> Print
                        </button>
                    </div>

                    <div class="cm-search-wrap" id="joSearchWrap">
                        <div class="cm-search-chip"><i class="ri-search-line cm-search-icon"></i></div>
                        <input type="text" id="joSearchInput" class="cm-search-input" placeholder="Search records..." autocomplete="off">
                        <span class="cm-search-count" id="joSearchCount"></span>
                        <button type="button" class="cm-search-clear" id="joSearchClearBtn" onclick="clearSearch()" title="Clear search (Esc)">
                            <i class="ri-close-line"></i>
                        </button>
                    </div>
                </div>

                <div class="cm-scroll-wrapper" id="joScrollWrapper">
                    <div class="cm-loader-overlay" id="joGridLoader">
                        <div class="cm-loader">
                            <div class="spinner-border text-primary" role="status"></div>
                            <span>Loading data...</span>
                        </div>
                    </div>
                    <table class="cm-table table table-hover align-middle mb-0" id="joGridTable">
                        <thead id="joGridTableHead">
                        </thead>
                        <tbody id="joGridBody">
                        </tbody>
                    </table>
                </div>

                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mt-3 pt-2 border-top">
                    <div class="cm-footer-info">
                        Showing <span class="fw-semibold" id="joShowingStart">0</span>
                        to <span class="fw-semibold" id="joShowingEnd">0</span>
                        of <span class="fw-semibold" id="joTotalEntries">0</span> entries
                    </div>
                    <ul class="pagination pagination-separated pagination-sm cm-pagination mb-0" id="joPaginationContainer"></ul>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- View details modal -->
<div class="modal fade" id="joViewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header cm-view-modal-header">
                <div>
                    <h5 class="modal-title" id="joViewTitle">Record Details</h5>
                    <small class="cm-view-subtitle" id="joViewSubtitle"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="cm-view-grid" id="joViewBody"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>