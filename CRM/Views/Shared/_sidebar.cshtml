@using System
@using System.Linq
@using CRM.Data
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var dataAccess = new DataAccess(Configuration.GetConnectionString("DefaultConnection")!);
    var dynamicReportsList = await dataAccess.GetWebTblMasterAsync();
    var categoryGroups = await new CategoryDataAccess(Configuration.GetConnectionString("DefaultConnection")!).GetGroupsAsync();
    var rmTables = categoryGroups.Where(x => string.Equals(x.Group, "RM", StringComparison.OrdinalIgnoreCase)).SelectMany(x => x.Tables).ToList();
    var sfgTables = categoryGroups.Where(x => string.Equals(x.Group, "SFG", StringComparison.OrdinalIgnoreCase)).SelectMany(x => x.Tables).ToList();
    var fsgTables = categoryGroups.Where(x => string.Equals(x.Group, "FSG", StringComparison.OrdinalIgnoreCase)).SelectMany(x => x.Tables).ToList();
    var masterDynamicReports = dynamicReportsList
        .Where(x => string.Equals(x.Report_Type?.Trim(), "MASTER_DYNAMIC", StringComparison.OrdinalIgnoreCase))
        .ToList();
    var reportDynamicReports = dynamicReportsList
        .Where(x => string.Equals(x.Report_Type?.Trim(), "REPORT_DYNAMIC", StringComparison.OrdinalIgnoreCase))
        .ToList();
}
<!-- ========== App Menu ========== -->
<div class="app-menu navbar-menu">
    <!-- LOGO -->
<div class="navbar-brand-box">
    <div class="logo logo-dark">
        <span class="logo-sm"><i class="ri-database-2-line fs-20 text-white"></i></span>
        <span class="logo-lg fw-bold fs-5 text-white" style="letter-spacing: 1.5px; color: #ffffff!important;">ERP SYSTEM</span>
    </div>
    <div class="logo logo-light">
        <span class="logo-sm"><i class="ri-database-2-line fs-20 text-white"></i></span>
        <span class="logo-lg fw-bold fs-5" style="letter-spacing: 1.5px; color: #ffffff!important;">ERP SYSTEM</span>
    </div>
    <button type="button" class="btn btn-sm p-0 fs-20 header-item float-end btn-vertical-sm-hover" id="vertical-hover">
        <i class="ri-record-circle-line text-white-50"></i>
    </button>
</div>

    <div class="dropdown sidebar-user m-1 rounded">
        <button type="button" class="btn material-shadow-none" id="page-header-user-dropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <span class="d-flex align-items-center gap-2">
                <img class="rounded header-profile-user" src="/assets/images/users/avatar-1.jpg" alt="Header Avatar">
                <span class="text-start">
                    <span class="d-block fw-medium sidebar-user-name-text">Admin</span>
                    <span class="d-block fs-14 sidebar-user-name-sub-text"><i class="ri ri-circle-fill fs-10 text-success align-baseline"></i> <span class="align-middle">Online</span></span>
                </span>
            </span>
        </button>
        <div class="dropdown-menu dropdown-menu-end">
            <h6 class="dropdown-header">Welcome Admin!</h6>
            <a class="dropdown-item" href="@Url.Action("LogoutBasic", "Authentication")"><i class="mdi mdi-logout text-muted fs-16 align-middle me-1"></i> <span class="align-middle" data-key="t-logout">Logout</span></a>
        </div>
    </div>

    <div id="scrollbar">
        <div class="container-fluid">
            <div id="two-column-menu">
            </div>
            <ul class="navbar-nav" id="navbar-nav">
                <li class="menu-title"><span data-key="t-menu">MENU</span></li>
                <li class="nav-item">
                    <a href="@Url.Action("Index", "DashBoard")" class="nav-link menu-link">
                        <i class="ri-dashboard-line"></i> <span data-key="t-dashboard">Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#sidebarMaster" data-bs-toggle="collapse" class="nav-link menu-link" role="button" aria-expanded="false" aria-controls="sidebarMaster">
                        <i class="ri-database-2-line"></i> <span data-key="t-master">Master</span>
                    </a>
                    <div class="collapse menu-dropdown" id="sidebarMaster">
                        <ul class="nav nav-sm flex-column">
                            @foreach (var master in masterDynamicReports)
                            {
                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "DynamicReport", new { tableName = master.Tbl_View_Name })" class="nav-link">@master.Report_Name</a>
                                </li>
                            }
                        </ul>
                    </div>
                </li>
                <li class="nav-item">
                    <a href="#sidebarReports" data-bs-toggle="collapse" class="nav-link menu-link" role="button" aria-expanded="false" aria-controls="sidebarReports">
                        <i class="ri-bar-chart-2-line"></i> <span data-key="t-reports">Reports</span>
                    </a>
                    <div class="collapse menu-dropdown" id="sidebarReports">
                        <ul class="nav nav-sm flex-column">
                            @foreach (var report in reportDynamicReports)
                            {
                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "DynamicReport", new { tableName = report.Tbl_View_Name })" class="nav-link">@report.Report_Name</a>
                                </li>
                            }
                        </ul>
                    </div>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("Index", "BarcodeScan")" class="nav-link menu-link">
                        <i class="ri-barcode-box-line"></i> <span>Barcode Scan</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#sidebarTransaction" data-bs-toggle="collapse" class="nav-link menu-link" role="button" aria-expanded="false" aria-controls="sidebarTransaction">
                        <i class="ri-swap-box-line"></i> <span data-key="t-transactions">Transaction</span>
                    </a>
                    <div class="collapse menu-dropdown" id="sidebarTransaction">
                        <ul class="nav nav-sm flex-column">
                            @* A group link is a plain collapse trigger exactly like the
                               Transaction link above it - it only opens the list of its
                               own tables. Choosing a table from that list is what opens
                               the page. *@
                            <li class="nav-item">
                                <a href="#sidebarCatRM" data-bs-toggle="collapse" class="nav-link cat-group-link" role="button" aria-expanded="false" aria-controls="sidebarCatRM" data-cat-group="RM" data-cat-collapse="sidebarCatRM">
                                    <i class="ri-folder-line"></i> <span>Category RM</span>
                                    <i class="ri-arrow-right-s-line cat-caret"></i>
                                </a>
                                <div class="collapse menu-dropdown" id="sidebarCatRM">
                                    <ul class="nav nav-sm flex-column" data-cat-tables="RM">
                                        @foreach (var table in rmTables)
                                        {
                                            <li class="nav-item">
                                                <a href="@Url.Action("Index", "Category", new { group = "RM", tableName = table.TableName })" class="nav-link">@table.Label</a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </li>
                            <li class="nav-item">
                                <a href="#sidebarCatSFG" data-bs-toggle="collapse" class="nav-link cat-group-link" role="button" aria-expanded="false" aria-controls="sidebarCatSFG" data-cat-group="SFG" data-cat-collapse="sidebarCatSFG">
                                    <i class="ri-folder-line"></i> <span>Category SFG</span>
                                    <i class="ri-arrow-right-s-line cat-caret"></i>
                                </a>
                                <div class="collapse menu-dropdown" id="sidebarCatSFG">
                                    <ul class="nav nav-sm flex-column" data-cat-tables="SFG">
                                        @foreach (var table in sfgTables)
                                        {
                                            <li class="nav-item">
                                                <a href="@Url.Action("Index", "Category", new { group = "SFG", tableName = table.TableName })" class="nav-link">@table.Label</a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </li>
                            <li class="nav-item">
                                <a href="#sidebarCatFSG" data-bs-toggle="collapse" class="nav-link cat-group-link" role="button" aria-expanded="false" aria-controls="sidebarCatFSG" data-cat-group="FSG" data-cat-collapse="sidebarCatFSG">
                                    <i class="ri-folder-line"></i> <span>Category FSG</span>
                                    <i class="ri-arrow-right-s-line cat-caret"></i>
                                </a>
                                <div class="collapse menu-dropdown" id="sidebarCatFSG">
                                    <ul class="nav nav-sm flex-column" data-cat-tables="FSG">
                                        @foreach (var table in fsgTables)
                                        {
                                            <li class="nav-item">
                                                <a href="@Url.Action("Index", "Category", new { group = "FSG", tableName = table.TableName })" class="nav-link">@table.Label</a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </li>
                        </ul>
                    </div>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- ========== App Menu end ========== -->

<style>
    /* FIX: White background hatane ke liye */
    #navbar-nav.menu-dropdown {
        background: transparent!important;
        padding-left: 10px;
        padding-right: 10px;
    }
    #navbar-nav.menu-dropdown.nav-sm.nav-link {
        border-radius: 8px;
        color: rgba(255,255,255,0.70)!important;
        background: transparent!important;
    }
    #navbar-nav.menu-dropdown.nav-sm.nav-link:hover {
        color: #ffffff!important;
        background: rgba(255, 255, 255, 0.07)!important;
    }
    #navbar-nav.menu-dropdown.nav-link.active {
        background: rgba(255, 255, 255, 0.12)!important;
        color: #ffffff!important;
        border-radius: 8px;
        font-weight: 600;
    }
    #navbar-nav.menu-dropdown.nav-link.active::before {
        background-color: #ffffff!important;
        opacity: 1;
    }
    #navbar-nav.menu-link.active,
    #navbar-nav.menu-link[aria-expanded="true"] {
        color: #ffffff!important;
        background: transparent!important;
        font-weight: 600;
    }
    #sidebarTransaction .cat-group-link { font-weight: 700; }
    #sidebarTransaction [data-cat-tables] .nav-link { font-weight: 600; }
</style>

<script>
(function () {
    var menu = document.getElementById('navbar-nav');
    if (!menu) return;

    var alwaysOpen = new Set();
    var collapsibles = menu.querySelectorAll('.collapse.menu-dropdown');
    Array.prototype.forEach.call(collapsibles, function (el) {
        if (el.classList.contains('show')) alwaysOpen.add(el.id);
    });
    function matchingHref(a) {
        var href = a.getAttribute('href');
        if (!href || href === '#' || href.indexOf('javascript:') === 0) return '';
        href = href.split('?')[0].split('#')[0];
        if (!href || href === '/' || href === '') return '';
        return href;
    }
    // matchingHref() drops the query string, so three links like
    // /Category?group=RM|SFG|FSG all collapse to the same path and pathname
    // alone cannot tell them apart. The group has to be compared too.
    function groupOf(href) {
        var m = (href || '').match(/[?&]group=([^&#]+)/i);
        return m ? decodeURIComponent(m[1]).toLowerCase() : '';
    }
    function tableOf(href) {
        var m = (href || '').match(/[?&]tableName=([^&#]+)/i);
        return m ? decodeURIComponent(m[1]).toLowerCase() : '';
    }
    function openCollapse(collapse) {
        if (!collapse) return;
        alwaysOpen.add(collapse.id);
        collapse.classList.add('show');
        var parent = collapse.parentElement;
        var trigger = parent? parent.querySelector(':scope > a') : null;
        if (trigger) {
            trigger.classList.remove('collapsed');
            trigger.setAttribute('aria-expanded', 'true');
            trigger.classList.add('active');
        }
        var parentCollapse = collapse.parentElement
            ? collapse.parentElement.closest('.collapse.menu-dropdown')
            : null;
        if (parentCollapse) openCollapse(parentCollapse);
    }
    function restoreOpen() {
        Array.prototype.forEach.call(collapsibles, function (other) {
            if (!alwaysOpen.has(other.id) || other.classList.contains('show')) return;
            openCollapse(other);
        });
    }
    function highlight() {
        try {
            var path = window.location.pathname;
            var here = groupOf(window.location.search);

            // Clear only what this function set last time, otherwise a group
            // switch would leave the previous link lit as well.
            Array.prototype.forEach.call(menu.querySelectorAll('[data-nav-active]'), function (el) {
                el.classList.remove('active');
                el.removeAttribute('data-nav-active');
            });

            var subLinks = menu.querySelectorAll('.menu-dropdown a[href]');
            for (var i = 0; i < subLinks.length; i++) {
                var a = subLinks[i];
                var href = matchingHref(a);
                if (!href) continue;
                if (path === href || path.indexOf(href + '/') === 0) {
                    if (href.toLowerCase() === '/category' &&
                        (groupOf(a.getAttribute('href')) !== here ||
                         tableOf(a.getAttribute('href')) !== tableOf(window.location.search))) continue;
                    a.classList.add('active');
                    a.setAttribute('data-nav-active', '1');
                    openCollapse(a.closest('.collapse.menu-dropdown'));
                }
            }
            var flatLinks = menu.querySelectorAll(':scope >.nav-item > a[href]:not([data-bs-toggle])');
            for (var j = 0; j < flatLinks.length; j++) {
                var flat = flatLinks[j];
                var flatHref = matchingHref(flat);
                if (!flatHref || !(path === flatHref || path.indexOf(flatHref + '/') === 0)) continue;
                if (groupOf(flat.getAttribute('href')) !== here) continue;
                flat.classList.add('active');
                flat.setAttribute('data-nav-active', '1');
            }
        } catch (e) { }
    }
    highlight();
    document.addEventListener('DOMContentLoaded', highlight);
    window.addEventListener('load', highlight);
    // Pages that swap content without a reload (the Category group switch) tell
    // the sidebar to re-evaluate, since this script only runs on a full load.
    document.addEventListener('sidebar:refresh', highlight);
    document.addEventListener('hidden.bs.collapse', function (e) {
        if (e.target && e.target.classList && e.target.classList.contains('menu-dropdown')) {
            alwaysOpen.delete(e.target.id);
        }
    }, true);
    document.addEventListener('shown.bs.collapse', function (e) {
        if (e.target && e.target.classList && e.target.classList.contains('menu-dropdown')) {
            alwaysOpen.add(e.target.id);
            restoreOpen();
        }
    }, true);
})();
</script>